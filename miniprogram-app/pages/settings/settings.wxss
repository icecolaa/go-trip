.settings .scroll { padding-bottom: 40rpx; }
.st-card { margin: 12rpx 32rpx 20rpx; padding: 10rpx 0; }
.st-head { display: flex; align-items: center; padding: 20rpx 26rpx 6rpx; }
.st-head .t { font-size: 29rpx; font-weight: 800; color: var(--ink); }
.st-head .tag { margin-left: auto; }
.st-opts { display: flex; gap: 16rpx; padding: 16rpx 22rpx 22rpx; }
.st-opt { flex: 1; border: 3rpx solid var(--line); border-radius: 24rpx; padding: 18rpx 0; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.st-opt .t { font-size: 26rpx; font-weight: 800; color: var(--ink2); }
.st-opt .s { font-size: 19rpx; color: var(--ink3); }
.st-opt.on { border-color: var(--sky400); background: var(--sky50); }
.st-opt.on .t { color: var(--sky600); }
.ver { display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 24rpx 0; }
.ver image { width: 56rpx; height: 56rpx; border-radius: 18rpx; opacity: .9; }
.ver text { font-size: 20rpx; color: var(--ink3); }

/* 转发触发层：透明 cover button 铺满所在 .cell（UA width:184px 被 100% 拉伸+opacity:0 归零可见性） */
.st-share-cover { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; margin: 0; padding: 0; border: none; border-radius: 0; background: transparent; z-index: 5; }
.st-share-cover::after { border: none; }

/* 页面级修正：全局 .cell-main 的描述样式选择器写的是 p 元素（137 行历史笔误），
   .p 类从未命中 → h/p 连排一行。settings 四列在此统一两行排版（1.5.21） */
.st-card .cell-main { display: flex; flex-direction: column; }
.st-card .cell-main .p { font-size: 23rpx; color: var(--ink3); margin-top: 2rpx; }
