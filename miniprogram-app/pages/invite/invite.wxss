.invitemain { background: var(--bg); }

.ghost { position: absolute; left: 0; right: 0; top: 0; padding: 200rpx 32rpx 0; }
.g-card { background: #fff; border-radius: 32rpx; height: 128rpx; margin-bottom: 24rpx; opacity: .85; }
.g-card.hero { height: 240rpx; background: linear-gradient(135deg, #E4EEF6, #D8E7F3); }
.g-row { display: flex; gap: 24rpx; margin-bottom: 24rpx; }
.g-box { flex: 1; height: 220rpx; background: #fff; border-radius: 32rpx; opacity: .85; }

.invite-sheet { height: 1200rpx; display: flex; flex-direction: column; }

.head { display: flex; align-items: center; padding-bottom: 24rpx; }
.head .t { font-size: 36rpx; font-weight: 900; color: var(--ink); }
.head .hint { font-size: 23rpx; color: var(--ink3); margin: 0 auto 0 20rpx; }
.head .x { width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--bg); display: flex; align-items: center; justify-content: center; }
.head .x .ic { width: 26rpx; height: 26rpx; color: var(--ink3); }

.share-card {
  display: flex; align-items: center; gap: 24rpx; border: 2rpx solid var(--line);
  border-radius: 28rpx; padding: 22rpx; background: var(--card);
}
.share-card .cover { width: 124rpx; height: 124rpx; border-radius: 20rpx; flex: none; }
.share-card .mid { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.share-card .t { font-size: 29rpx; font-weight: 700; color: var(--ink); }
.share-card .s { font-size: 23rpx; color: var(--ink3); margin-top: 6rpx; }
.share-card .src { display: flex; align-items: center; gap: 8rpx; margin-top: 12rpx; font-size: 20rpx; color: var(--ink3); }
.share-card .mini { width: 28rpx; height: 28rpx; border-radius: 8rpx; }

.qr-area { display: flex; align-items: center; gap: 32rpx; padding: 22rpx 4rpx 18rpx; }
.qr-box { width: 224rpx; height: 224rpx; flex: none; box-shadow: var(--sh-card); border: 2rpx solid var(--line); }
.qr-box .qr-inner { height: 192rpx !important; }
.qr-area .t { display: flex; flex-direction: column; }
.qr-area .h3 { font-size: 31rpx; font-weight: 800; color: var(--ink); }
.qr-area .p { font-size: 24rpx; color: var(--ink2); margin-top: 8rpx; line-height: 1.5; }

.ways { display: flex; justify-content: space-between; padding: 4rpx 12rpx 8rpx; }
.way { display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.way-ic { width: 92rpx; height: 92rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.way-ic .ic { width: 44rpx; height: 44rpx; color: #fff; }
.way-ic.wechat { background: linear-gradient(135deg, #2FD376, var(--wechat)); }
.way-ic.moments { background: linear-gradient(135deg, #4BC48B, var(--teal)); }
.way-ic.link { background: linear-gradient(135deg, var(--sky400), var(--sky600)); }
.way-ic.face { background: linear-gradient(135deg, #FFDE5C, var(--yel500)); }
.way text { font-size: 21rpx; color: var(--ink2); }

.mem-title { display: flex; align-items: center; margin: 16rpx 0 16rpx; }
.mem-title .b { font-size: 27rpx; font-weight: 800; color: var(--ink); }
.mem-title .s { font-size: 22rpx; color: var(--ink3); margin-left: auto; }
.mem-row { display: flex; align-items: center; gap: 20rpx; padding: 12rpx 0; }
.mem-row .avatar { width: 76rpx; height: 76rpx; }
.m-info { flex: 1; display: flex; flex-direction: column; }
.m-info .l1 { display: flex; align-items: center; gap: 12rpx; }
.m-info .n { font-size: 27rpx; font-weight: 700; color: var(--ink); }
.m-info .d { font-size: 21rpx; color: var(--ink3); margin-top: 2rpx; }
