.settle .scroll { padding-bottom: 40rpx; }

.hero-card {
  margin: 12rpx 32rpx 0; padding: 32rpx; border-radius: 40rpx; position: relative; overflow: hidden;
  background: linear-gradient(135deg, #FFFDF4, #FFF3C8); border: 2rpx solid #FFE9A8;
  box-shadow: 0 20rpx 48rpx rgba(255,196,20,.2);
  display: flex; flex-direction: column;
}
.save-tag {
  position: absolute; right: 28rpx; top: 28rpx; background: #E4572E; color: #fff;
  font-size: 21rpx; font-weight: 800; border-radius: 999rpx; padding: 8rpx 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(228,87,46,.35);
}
.hero-card .lab { display: flex; align-items: center; gap: 12rpx; font-size: 24rpx; font-weight: 800; color: #B8860B; }
.hero-card .lab .ic { width: 30rpx; height: 30rpx; }
.hero-card .h { font-size: 38rpx; font-weight: 900; color: #6B5200; margin-top: 14rpx; line-height: 1.4; }
.hero-card .hl { color: #E4572E; }
.hero-card .tags { display: flex; gap: 12rpx; margin-top: 20rpx; flex-wrap: wrap; }

.trans {
  display: flex; align-items: center; gap: 20rpx; background: var(--card);
  border-radius: 32rpx; box-shadow: var(--sh-card); padding: 24rpx 26rpx; margin: 0 32rpx 20rpx;
}
.pair { display: flex; align-items: center; flex: 1; min-width: 0; }
.who { display: flex; flex-direction: column; align-items: center; gap: 6rpx; width: 104rpx; flex: none; }
.who .avatar { border-width: 0; }
.who text { font-size: 20rpx; color: var(--ink2); white-space: nowrap; }
.arrow { flex: 1; display: flex; align-items: center; gap: 10rpx; padding: 0 8rpx; }
.arrow .line { flex: 1; height: 4rpx; border-radius: 2rpx; background: repeating-linear-gradient(90deg, var(--sky400) 0 12rpx, transparent 12rpx 22rpx); }
.arrow .ic { width: 30rpx; height: 30rpx; }
.money { text-align: right; flex: none; display: flex; flex-direction: column; }
.money .v { font-size: 36rpx; font-weight: 900; color: var(--sky700); }
.money .k { font-size: 19rpx; color: var(--ink3); margin-top: 2rpx; }
.act { flex: none; margin-left: 16rpx; height: 56rpx; padding: 0 24rpx; border-radius: 28rpx; display: flex; align-items: center; font-size: 24rpx; }
.act.mark { background: linear-gradient(135deg, #FFDE5C, var(--yel500)); color: #6B5200; font-weight: 800; }
.act.paid { border: 3rpx solid var(--line); color: var(--green); font-weight: 700; }

.detail-card { margin: 0 32rpx; padding: 6rpx 0; }
.detail-row { display: flex; align-items: center; gap: 20rpx; padding: 18rpx 28rpx; border-bottom: 2rpx solid var(--line); }
.detail-row:last-child { border-bottom: none; }
.detail-row .avatar { width: 60rpx; height: 60rpx; font-size: 22rpx; }
.n-wrap { flex: 1; display: flex; flex-direction: column; }
.n-wrap .n { font-size: 26rpx; font-weight: 600; color: var(--ink); }
.n-wrap .calc { font-size: 21rpx; color: var(--ink3); }
.net { font-size: 28rpx; font-weight: 800; width: 128rpx; text-align: right; }
.net.pos { color: var(--green); }
.net.neg { color: var(--red); }

.foot-note {
  display: flex; align-items: center; gap: 16rpx; margin: 20rpx 32rpx 0;
  padding: 20rpx 24rpx; background: var(--card); border-radius: 28rpx; box-shadow: var(--sh-card);
}
.foot-note image { width: 60rpx; height: 60rpx; border-radius: 50%; }
.foot-note .txt { flex: 1; font-size: 23rpx; color: var(--ink2); line-height: 1.45; }
.foot-note .b { font-weight: 800; color: var(--ink); }

.bottom-cta {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 35;
  padding: 20rpx 32rpx calc(44rpx + env(safe-area-inset-bottom));
  display: flex; gap: 20rpx;
  background: linear-gradient(180deg, rgba(243,248,252,0), var(--bg) 40%);
}
.grow { flex: 1; }
.remind { flex: 1.6; }
