.mapscreen { background: #E7F0F7; }
.map-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.map-attr {
  position: fixed; left: 20rpx; z-index: 6; font-size: 19rpx; color: var(--ink3);
  background: rgba(255,255,255,.75); border-radius: 12rpx; padding: 4rpx 12rpx;
}

.day-seg {
  position: absolute; left: 50%; transform: translateX(-50%); top: 200rpx; z-index: 21;
  display: flex; background: var(--card); border-radius: 34rpx; padding: 6rpx;
  box-shadow: 0 8rpx 28rpx rgba(23,84,153,.14);
}
.day-seg text { font-size: 24rpx; font-weight: 700; color: var(--ink2); padding: 10rpx 22rpx; border-radius: 26rpx; }
.day-seg .on { background: #2E92ED; color: #fff; }

.float-ctrl { position: fixed; right: 24rpx; top: 420rpx; z-index: 10; display: flex; flex-direction: column; gap: 18rpx; }
.fc {
  width: 80rpx; height: 80rpx; border-radius: 50%; background: var(--card);
  box-shadow: 0 10rpx 28rpx rgba(23,84,153,.16);
  display: flex; align-items: center; justify-content: center;
}
.fc .ic { width: 36rpx; height: 36rpx; color: var(--sky600); }
.fc.loc { background: linear-gradient(135deg, var(--sky400), var(--sky600)); }
.minus { font-size: 38rpx; font-weight: 300; color: var(--sky600); line-height: 1; }

.map-sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; background: var(--card);
  border-radius: 48rpx 48rpx 0 0; box-shadow: 0 -20rpx 60rpx rgba(15,45,80,.16);
  padding: 16rpx 32rpx 0;
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
}
.ms-head { display: flex; align-items: center; gap: 16rpx; padding: 8rpx 0 16rpx; }
.ms-head .t { font-size: 32rpx; font-weight: 900; color: var(--ink); }
.ms-head .date { margin-left: auto; font-size: 23rpx; color: var(--ink3); }
.ms-stats { display: flex; gap: 16rpx; padding-bottom: 20rpx; }
.stat { flex: 1; background: var(--sky100); border-radius: 24rpx; padding: 16rpx 20rpx; display: flex; flex-direction: column; }
.stat .v { font-size: 30rpx; font-weight: 900; color: var(--sky600); }
.stat .k { font-size: 20rpx; color: var(--ink3); margin-top: 2rpx; }
.stat.yellow .v { color: #B8860B; }
.poi-strip { display: flex; gap: 18rpx; padding-bottom: 24rpx; overflow: hidden; }
.poi-mini { flex: none; width: 208rpx; border-radius: 24rpx; border: 2rpx solid var(--line); overflow: hidden; }
.poi-mini image { width: 100%; height: 104rpx; }
.p-body { padding: 10rpx 16rpx 14rpx; display: flex; flex-direction: column; }
.p-body .b { font-size: 22rpx; font-weight: 700; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.p-body .s { font-size: 19rpx; color: var(--ink3); }
.ms-cta { display: flex; gap: 20rpx; padding-bottom: 16rpx; }
.grow { flex: 1; }
.share { width: 220rpx; height: 96rpx; }

/* 双图层 */
.map-bg.hide { display: none; }

/* 按天分色站点标记 */
.mk {
  position: absolute; z-index: 8; width: 52rpx; height: 52rpx; border-radius: 50% 50% 50% 6rpx;
  transform: rotate(-45deg); display: flex; align-items: center; justify-content: center;
  border: 4rpx solid #fff; box-shadow: 0 6rpx 16rpx rgba(23,84,153,.25);
}
.mk text { transform: rotate(45deg); color: #fff; font-size: 22rpx; font-weight: 900; }
.mk-d1 { background: #2BB8A8; } .mk-d2 { background: #2E92ED; } .mk-d3 { background: #FF8A5C; } .mk-d4 { background: #7B8CFF; }
.mk.hide { display: none; }

/* 成员位置 */
.mem-loc { position: absolute; z-index: 9; }
.mem-loc .avatar { box-shadow: 0 6rpx 16rpx rgba(23,84,153,.3); }

/* 站点横滑卡 */
.stop-strip { white-space: nowrap; padding-bottom: 20rpx; }
.poi-mini { position: relative; display: inline-block; vertical-align: top; margin-right: 16rpx; background: var(--card); }
.poi-mini .s-dot {
  position: absolute; left: 10rpx; top: 10rpx; z-index: 2; width: 34rpx; height: 34rpx; border-radius: 50%;
  color: #fff; font-size: 19rpx; font-weight: 900; text-align: center; line-height: 34rpx; border: 2rpx solid #fff;
}
.s-dot.d1 { background: #2BB8A8; } .s-dot.d2 { background: #2E92ED; } .s-dot.d3 { background: #FF8A5C; } .s-dot.d4 { background: #7B8CFF; }
.poi-mini .s-ops { display: flex; border-top: 2rpx solid var(--line); }
.s-op { flex: 1; display: flex; align-items: center; justify-content: center; padding: 10rpx 0; }
.s-op .ic { width: 26rpx; height: 26rpx; color: var(--sky500); }
.s-op.xhs { border-left: 2rpx solid var(--line); }
.xhs-t { color: #FF2442; font-size: 21rpx; font-weight: 900; }
