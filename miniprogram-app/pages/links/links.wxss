.linkspg .scroll { padding-bottom: 40rpx; }
.lk-add { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 28rpx; margin: 12rpx 32rpx 20rpx; }
.lk-add-ic { width: 76rpx; height: 76rpx; border-radius: 24rpx; background: var(--sky100); display: flex; align-items: center; justify-content: center; flex: none; }
.lk-add-ic .ic { width: 36rpx; height: 36rpx; color: var(--sky500); }
.lk-add-txt { flex: 1; display: flex; flex-direction: column; }
.lk-add-txt .t { font-size: 28rpx; font-weight: 800; color: var(--ink); }
.lk-add-txt .s { font-size: 21rpx; color: var(--ink3); margin-top: 2rpx; }

.lk-item { display: flex; align-items: center; gap: 20rpx; background: var(--card); border-radius: 28rpx; box-shadow: var(--sh-card); padding: 22rpx 24rpx; margin: 0 32rpx 18rpx; }
.lk-src {
  width: 72rpx; height: 72rpx; border-radius: 20rpx; flex: none;
  color: #fff; font-size: 21rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
}
.lk-src.xhs { background: #FF2442; }
.lk-src.weixin { background: #07C160; }
.lk-src.web { background: #51637A; }
.lk-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.lk-main .t { font-size: 27rpx; font-weight: 700; color: var(--ink); }
.lk-main .u { font-size: 20rpx; color: var(--ink3); margin-top: 4rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.lk-go { flex: none; }
.lk-go .ic { width: 26rpx; height: 26rpx; color: var(--ink3); }

.lk-empty { display: flex; flex-direction: column; align-items: center; gap: 10rpx; padding: 100rpx 0 40rpx; }
.lk-empty .t { font-size: 30rpx; font-weight: 800; color: var(--ink2); }
.lk-empty .s { font-size: 23rpx; color: var(--ink3); padding: 0 60rpx; text-align: center; line-height: 1.6; }
