.flightspg .scroll { padding-bottom: 40rpx; }
.fl-form { margin: 12rpx 32rpx 0; padding: 26rpx 28rpx; }
.fl-row { display: flex; align-items: flex-end; gap: 20rpx; }
.fl-field { flex: 1; display: flex; flex-direction: column; }
.fl-field.w { border: 2rpx solid var(--line); border-radius: 20rpx; padding: 14rpx 20rpx; background: var(--bg); }
.fl-swap { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--sky100); display: flex; align-items: center; justify-content: center; flex: none; margin-bottom: 4rpx; }
.fl-swap .ic { width: 30rpx; height: 30rpx; color: var(--sky600); }
.lab { font-size: 21rpx; color: var(--ink3); font-weight: 600; margin-bottom: 6rpx; }
.fl-input { font-size: 30rpx; font-weight: 800; color: var(--ink); height: 56rpx; }
.fl-val { font-size: 30rpx; font-weight: 800; color: var(--ink); }
.ph { color: var(--ink3); }
.fl-row2 { display: flex; gap: 20rpx; margin: 20rpx 0; }
.stepper { display: flex; align-items: center; gap: 18rpx; height: 56rpx; }
.st-btn { width: 52rpx; height: 52rpx; border-radius: 50%; background: var(--sky100); text-align: center; line-height: 48rpx; color: var(--sky600); font-size: 34rpx; font-weight: 800; }
.st-btn.plus { background: var(--yel100); color: #B8860B; }
.st-num { font-size: 32rpx; color: var(--ink); }

.fl-card { background: var(--card); border-radius: 32rpx; box-shadow: var(--sh-card); padding: 24rpx 26rpx; margin: 0 32rpx 18rpx; }
.fl-c-head { display: flex; align-items: center; }
.fl-c-head .t { font-size: 29rpx; font-weight: 800; color: var(--ink); }
.fl-c-head .tag { margin-left: auto; }
.fl-c-body { display: flex; align-items: center; margin-top: 18rpx; }
.fl-time { flex: 1; display: flex; align-items: center; gap: 16rpx; }
.fl-time .big { font-size: 36rpx; font-weight: 900; color: var(--ink); }
.fl-line { flex: 1; display: flex; align-items: center; gap: 6rpx; }
.fl-line .line { flex: 1; height: 3rpx; background: var(--sky200); border-radius: 2rpx; }
.fl-price { text-align: right; display: flex; flex-direction: column; }
.fl-price .per { font-size: 30rpx; font-weight: 900; color: #E4572E; }
.fl-price .total { font-size: 20rpx; color: var(--ink3); margin-top: 2rpx; }
.fl-c-foot { display: flex; align-items: center; justify-content: flex-end; gap: 6rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 2rpx dashed var(--line); font-size: 23rpx; color: var(--sky600); font-weight: 700; }

.fl-tip { margin: 8rpx 32rpx 0; padding: 24rpx 26rpx; }
.fl-tip-head { display: flex; align-items: center; gap: 14rpx; margin-bottom: 16rpx; }
.fl-tip-head .face { width: 52rpx; height: 52rpx; border-radius: 50%; border: 3rpx solid #fff; }
.fl-tip-head .t { font-size: 27rpx; font-weight: 800; color: var(--ink); }
.fl-tip-head .tag { margin-left: auto; }
.wx-strip { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.wx-day { flex: 1; background: var(--bg); border-radius: 20rpx; padding: 14rpx 0; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.wx-day .d { font-size: 20rpx; color: var(--ink3); }
.wx-day .i { font-size: 30rpx; }
.wx-day .t2 { font-size: 20rpx; color: var(--ink2); font-weight: 700; }
.fl-tip-item { display: flex; align-items: flex-start; gap: 12rpx; padding: 8rpx 0; }
.fl-tip-item text { flex: 1; font-size: 24rpx; color: var(--ink2); line-height: 1.5; }
