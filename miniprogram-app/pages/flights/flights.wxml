<!-- 飞哪儿：机票低价探索 · 按人数计价 · 天气与出行建议 -->
<view class="screen flightspg {{themeClass}}">
  <nav-bar float="{{true}}" back="{{true}}" />
  <view class="scroll">
    <view class="fl-form card anim-rise">
      <view class="chips" style="margin:4rpx 0 20rpx">
        <view class="chip {{trip === 'round' ? 'on' : ''}}" hover-class="press" bindtap="setTrip" data-v="round">往返</view>
        <view class="chip {{trip === 'oneway' ? 'on' : ''}}" hover-class="press" bindtap="setTrip" data-v="oneway">单程</view>
      </view>
      <view class="fl-row">
        <view class="fl-field">
          <text class="lab">出发地</text>
          <input class="fl-input" value="{{from}}" bindinput="onFrom" placeholder="如 北京" placeholder-class="ph" />
        </view>
        <view class="fl-swap" hover-class="press" bindtap="swapCity"><view class="ic ic-transfer"></view></view>
        <view class="fl-field">
          <text class="lab">目的地</text>
          <input class="fl-input" value="{{to}}" bindinput="onTo" placeholder="选填 · 随便飞哪儿" placeholder-class="ph" />
        </view>
      </view>
      <view class="fl-row2">
        <picker mode="date" value="{{date}}" bindchange="onDate">
          <view class="fl-field w">
            <text class="lab">出发日期</text>
            <text class="fl-val">{{date}}</text>
          </view>
        </picker>
        <picker wx:if="{{trip === 'round'}}" mode="date" value="{{backDate}}" bindchange="onBackDate">
          <view class="fl-field w">
            <text class="lab">返程日期</text>
            <text class="fl-val">{{backDate}}</text>
          </view>
        </picker>
        <view class="fl-field w">
          <text class="lab">人数</text>
          <view class="stepper">
            <view class="st-btn" hover-class="press" bindtap="decPax"><text>-</text></view>
            <text class="st-num num">{{pax}}</text>
            <view class="st-btn plus" hover-class="press" bindtap="incPax"><text>+</text></view>
          </view>
        </view>
      </view>
      <view class="btn ghost small btn-block" hover-class="press" bindtap="locate">
        <text>{{locating ? '定位识别中…' : '📍 定位识别出发地'}}</text>
      </view>
      <view class="btn btn-block" style="margin-top:16rpx" hover-class="press" bindtap="search">
        <view class="ic ic-search" style="width:30rpx;height:30rpx"></view>
        <text>{{searching ? '搜索中…已等待 ' + searchSec + ' 秒' : '探索低价组合'}}</text>
      </view>
    </view>

    <block wx:if="{{result}}">
      <view class="sec"><text class="h">低价组合</text><text class="tag yellow">{{pax}} 人 · 共 {{result.count}} 个组合</text></view>
      <view class="fl-card anim-rise" style="animation-delay:{{index * 70}}ms" wx:for="{{combos}}" wx:key="id">
        <view class="fl-c-head">
          <text class="t">{{item.type}}</text>
          <text class="tag {{index === 0 ? 'yellow' : 'blue'}}">{{item.note}}</text>
        </view>
        <view class="fl-c-body">
          <view class="fl-time">
            <text class="t-sub">{{trip === 'round' ? '去' : ''}}</text>
            <text class="big num">{{item.depart}}</text>
            <view class="fl-line"><view class="line"></view><view class="ic ic-send" style="width:24rpx;height:24rpx;color:var(--sky400)"></view><view class="line"></view></view>
            <text class="big num">{{item.arrive}}</text>
          </view>
          <view class="fl-price">
            <text class="per num">¥{{item.pricePax}}/人</text>
            <text class="total num">共 {{pax}} 人 ¥{{item.total}}</text>
          </view>
        </view>
        <view class="fl-c-body" wx:if="{{trip === 'round' && item.back}}">
          <view class="fl-time">
            <text class="t-sub">返</text>
            <text class="big num">{{item.back}}</text>
            <view class="fl-line"><view class="line"></view><view class="ic ic-send" style="width:24rpx;height:24rpx;color:var(--sky400)"></view><view class="line"></view></view>
            <text class="big num">{{item.backArr}}</text>
          </view>
        </view>
        <view class="fl-c-foot" hover-class="press" bindtap="copyFlight" data-index="{{index}}">
          <text>复制购票链接</text>
          <view class="ic ic-right" style="width:22rpx;height:22rpx"></view>
        </view>
      </view>

      <view class="fl-tip card anim-rise" wx:if="{{wx4.length || tips.length}}">
        <view class="fl-tip-head">
          <image class="face" src="/assets/logo.png" mode="aspectFill" />
          <text class="t">目的地天气与出行建议</text>
          <text class="tag gray">{{engineTag}}</text>
        </view>
        <view class="wx-strip" wx:if="{{wx4.length}}">
          <view class="wx-day" wx:for="{{wx4}}" wx:key="date">
            <text class="d">{{item.date}}</text>
            <text class="i">{{item.icon}}</text>
            <text class="t2 num">{{item.lo}}~{{item.hi}}°C</text>
          </view>
        </view>
        <view class="fl-tip-item" wx:for="{{tips}}" wx:key="*this">
          <view class="ic ic-check" style="width:26rpx;height:26rpx;color:#2FA96E"></view>
          <text>{{item}}</text>
        </view>
      </view>
    </block>
    <view style="height:60rpx"></view>
  </view>
</view>
