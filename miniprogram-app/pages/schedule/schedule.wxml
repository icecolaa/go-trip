<!-- 每日行程：按天编排 · 排序 · 跨天移动 · 费用/备注 -->
<view class="screen schedule {{themeClass}}">
  <nav-bar float="{{true}}" back="{{true}}" />

  <!-- 无行程空态 -->
  <view wx:if="{{!hasTrip}}" style="margin:200rpx 32rpx">
    <view class="card" style="padding:64rpx 40rpx;display:flex;flex-direction:column;align-items:center;gap:16rpx">
      <text class="t-sec">还没有选定行程</text>
      <text class="t-sub">请先从首页选择行程</text>
    </view>
  </view>

  <scroll-view class="scroll" scroll-y wx:if="{{hasTrip}}">
    <view class="days-bar">
      <view class="day-pill {{dayIdx === index ? 'on' : ''}}" wx:for="{{days}}" wx:key="d"
            hover-class="press" bindtap="pickDay" data-i="{{index}}">
        <text class="b">D{{item.d}}</text>
        <text class="s">{{item.date}}</text>
      </view>
    </view>
    <view class="date-line">
      <text class="d">{{days[dayIdx].date}}</text>
      <text class="w">{{days[dayIdx].week}} · {{dayStops.length}} 个地点 · 合计 ¥{{dayCost}}</text>
    </view>

    <view class="tl">
      <block wx:for="{{dayStops}}" wx:key="id">
        <view class="drive-chip" wx:if="{{item.leg}}">
          <view class="d-ic"><view class="ic ic-car"></view></view>
          <text>{{item.leg}}</text>
        </view>
        <view class="tl-item {{index === dayStops.length - 1 ? 'last' : ''}}">
          <view class="tl-time" wx:if="{{hasTime}}"><text>{{item.time}}</text></view>
          <view class="tl-node">
            <view class="dot {{item.type === '餐饮' ? 'meal' : item.type === '住宿' ? 'stay' : ''}}"></view>
            <view class="bar" wx:if="{{index < dayStops.length - 1}}"></view>
          </view>
          <view class="tl-card pad-sm">
            <view class="mini-tile {{item.type === '餐饮' ? 'yellow' : item.type === '住宿' ? 'blue' : item.type === '门票' ? 'green' : ''}}">
              <view class="ic ic-{{item.icon}}"></view>
            </view>
            <view class="tl-main">
              <text class="h">{{item.name}}</text>
              <view class="s">
                <text wx:if="{{item.cost > 0}}" class="tag yellow num">¥{{item.cost}}</text>
                <text wx:if="{{item.note}}" class="note">{{item.note}}</text>
              </view>
            </view>
            <view class="op" hover-class="press" bindtap="stopMenu" data-id="{{item.id}}">
              <view class="ic ic-drag"></view>
            </view>
          </view>
        </view>
      </block>
      <view wx:if="{{!dayStops.length}}" class="empty">
        <text>这一天还没有安排</text>
        <text class="tag blue">点底部「＋安排」或「候选库」补齐</text>
      </view>
    </view>
    <view class="cta-space"></view>
  </scroll-view>

  <view class="bottom-cta" wx:if="{{hasTrip}}">
    <view class="btn ghost map-pill" hover-class="press" bindtap="goMap">
      <view class="ic ic-map"></view><text>地图</text>
    </view>
    <view class="btn yellow grow" hover-class="press" bindtap="addPlan">
      <view class="ic ic-plus"></view><text>安排</text>
    </view>
    <view class="btn ghost grow" hover-class="press" bindtap="addPlace">
      <view class="ic ic-search"></view><text>候选库</text>
    </view>
  </view>

  <!-- ＋安排 表单弹层：名称 / 分类 / 地点(地图选点) -->
  <view wx:if="{{formShow}}" class="sheet-mask" bindtap="closeForm"></view>
  <view wx:if="{{formShow}}" class="sheet" catchtap="noop">
    <view class="grab"></view>
    <view class="edit-head"><text class="t">安排 · {{formDay.d}} {{formDay.date}}</text><view class="x" hover-class="press" bindtap="closeForm"><view class="ic ic-close"></view></view></view>
    <view class="edit-lab">名称</view>
    <view class="input">
      <view class="ic ic-flag"></view>
      <input value="{{formTitle}}" maxlength="40" placeholder="如：酒店入住 / 五营森林公园" placeholder-class="ph" bindinput="onFormTitle" style="flex:1;font-size:28rpx" />
    </view>
    <view class="edit-lab">分类</view>
    <view class="form-cats">
      <view wx:for="{{catItems}}" wx:key="*this" class="form-cat {{formKindIdx === index ? 'on' : ''}}" hover-class="press" bindtap="pickKind" data-i="{{index}}">{{item}}</view>
    </view>
    <view class="edit-lab">地点（选点后地图可规划路线）</view>
    <view class="input">
      <view class="ic ic-pin"></view>
      <input value="{{formPlace}}" maxlength="40" placeholder="地点名称，或右侧地图选点" placeholder-class="ph" bindinput="onFormPlace" style="flex:1;font-size:28rpx" />
      <view class="pick-btn" hover-class="press" bindtap="chooseOnMap"><view class="ic ic-loc" style="width:28rpx;height:28rpx;color:#fff"></view><text>选点</text></view>
    </view>
    <view class="btn btn-block" style="margin:30rpx 0 8rpx" hover-class="press" bindtap="saveForm"><text>添加安排</text></view>
  </view>
</view>

<input-sheet show="{{noteSheet.show}}" title="{{noteSheet.title}}" fields="{{noteSheet.fields}}"
             bind:confirm="onNoteSheet" bind:cancel="closeNoteSheet" />
