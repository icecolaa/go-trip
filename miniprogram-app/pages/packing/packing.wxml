<!-- 打包清单：云端清单 · 数量备注 · 勾选进度 -->
<view class="screen packing {{themeClass}}">
  <nav-bar float="{{true}}" back="{{true}}" />
  <view class="scroll">
    <view wx:if="{{noTrip}}" class="anim-rise" style="padding:140rpx 40rpx;text-align:center;">
      <text style="font-size:30rpx;color:var(--ink3)">请先从首页选择行程</text>
    </view>
    <block wx:else>
    <view class="pk-progress card anim-rise">
      <view class="pk-row">
        <text class="t">打包进度</text>
        <text class="r">{{doneCount}} / {{totalCount}} 件</text>
      </view>
      <view class="progress"><view class="bar" style="width:{{progress}}%"></view></view>
    </view>

    <view class="pk-group anim-rise" style="animation-delay:{{70}}ms" wx:for="{{groups}}" wx:key="name">
      <view class="pk-g-head">
        <view class="ic ic-{{item.icon}}" style="color:{{item.color}}"></view>
        <text class="g-name">{{item.name}}</text>
        <text class="g-count">{{item.items.length}} 件</text>
      </view>
      <view class="pk-item" wx:for="{{item.items}}" wx:for-item="it" wx:key="id"
            hover-class="press" bindtap="toggleItem" bindlongpress="delItem" data-id="{{it.id}}">
        <view class="pk-check {{it.done ? 'on' : ''}}"><view wx:if="{{it.done}}" class="ic ic-check"></view></view>
        <text class="pk-name {{it.done ? 'done' : ''}}">{{it.name}}</text>
        <text wx:if="{{it.qty}}" class="tag gray num">×{{it.qty}}</text>
        <text wx:if="{{it.note}}" class="pk-note">{{it.note}}</text>
      </view>
    </view>

    <view wx:if="{{!groups.length}}" class="anim-rise" style="padding:40rpx 20rpx;text-align:center;">
      <text style="font-size:26rpx;color:var(--ink3)">清单还是空的，试试一键导入出行模板</text>
    </view>

    <view class="pk-add" hover-class="press" bindtap="importTemplate">
      <view class="plus-ring"><view class="ic ic-check"></view></view>
      <text>一键导入出行模板</text>
    </view>
    <view class="pk-add" hover-class="press" bindtap="addItem">
      <view class="plus-ring"><view class="ic ic-plus"></view></view>
      <text>自定义物品</text>
    </view>
    <view style="height:60rpx"></view>
    </block>
  </view>
</view>
