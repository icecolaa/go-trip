.packing .scroll { padding-bottom: 40rpx; }
.pk-progress { margin: 12rpx 32rpx 20rpx; padding: 26rpx 30rpx; }
.pk-row { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.pk-row .t { font-size: 29rpx; font-weight: 800; color: var(--ink); }
.pk-row .r { font-size: 24rpx; color: var(--ink3); }

.pk-group { background: var(--card); border-radius: 32rpx; box-shadow: var(--sh-card); padding: 10rpx 24rpx; margin: 0 32rpx 20rpx; }
.pk-g-head { display: flex; align-items: center; gap: 12rpx; padding: 18rpx 4rpx 8rpx; }
.pk-g-head .ic { width: 32rpx; height: 32rpx; }
.pk-g-head .g-name { font-size: 27rpx; font-weight: 800; color: var(--ink); }
.pk-g-head .g-count { margin-left: auto; font-size: 21rpx; color: var(--ink3); }
.pk-item { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 4rpx; border-top: 2rpx solid var(--line); }
.pk-check { width: 44rpx; height: 44rpx; border-radius: 14rpx; border: 3rpx solid #C9D6E3; display: flex; align-items: center; justify-content: center; flex: none; }
.pk-check.on { background: var(--green); border-color: var(--green); }
.pk-check.on .ic { width: 24rpx; height: 24rpx; color: #fff; }
.pk-name { flex: 1; font-size: 26rpx; color: var(--ink); }
.pk-name.done { color: var(--ink3); text-decoration: line-through; }
.pk-note { font-size: 21rpx; color: var(--ink3); }
.pk-edit { width: 44rpx; height: 44rpx; display: flex; align-items: center; justify-content: center; flex: none; }
.pk-edit .ic { width: 24rpx; height: 24rpx; color: var(--ink3); }

.pk-add {
  margin: 8rpx 32rpx 0; height: 96rpx; border-radius: 32rpx; border: 3rpx dashed var(--sky300);
  display: flex; align-items: center; justify-content: center; gap: 14rpx;
  color: var(--sky600); font-size: 27rpx; font-weight: 700; background: var(--sky50);
}
.plus-ring { width: 40rpx; height: 40rpx; border-radius: 50%; background: var(--yel400); display: flex; align-items: center; justify-content: center; }
.plus-ring .ic { width: 22rpx; height: 22rpx; color: #6B5200; }

/* 分类手风琴箭头（1.5.28）：收起朝右、展开转下 */
.pk-g-head .g-arr { margin-left: auto; display: flex; align-items: center; transition: transform .2s ease; }
.pk-g-head .g-arr .ic { width: 26rpx; height: 26rpx; color: var(--ink3); }
.pk-g-head .g-arr.open { transform: rotate(90deg); }
