<!-- 首页 · 我的旅程列表 -->
<view class="screen home {{themeClass}}">
  <nav-bar>
    <view class="brandbar">
      <image class="logo" src="/assets/logo.png" mode="aspectFill" />
      <text class="cn">出发吧</text>
      <text class="en">GoTrip</text>
    </view>
  </nav-bar>

  <view class="greet">
    <text class="h1">{{greet}}，旅行家 </text>
    <text class="sub">{{sub}}</text>
  </view>

  <scroll-view class="scroll" scroll-y refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresherRefresh" refresher-default-style="black">
    <!-- 新建入口 -->
    <view wx:if="{{!loading && trips.length !== 0}}" class="create-btn anim-rise" hover-class="press" bindtap="goCreate">
      <view class="plus-ring"><view class="ic ic-plus"></view></view>
      <text>新建旅程</text>
    </view>

    <!-- 空态 -->
    <view wx:if="{{!loading && trips.length === 0}}" class="card anim-rise d1" style="margin:28rpx 32rpx 0;padding:56rpx 40rpx;display:flex;flex-direction:column;align-items:center;gap:16rpx">
      <text style="font-size:96rpx;line-height:1.2">✈️</text>
      <text class="t-title" style="margin-top:8rpx">还没有旅程</text>
      <text class="t-sub" style="text-align:center">创建第一段旅程，或先导入演示行程看看效果</text>
      <view class="btn yellow btn-block" style="margin-top:24rpx" hover-class="press" bindtap="importDemo">
        <text>导入演示行程</text>
      </view>
      <view class="btn ghost btn-block" hover-class="press" bindtap="goCreate">
        <text>新建旅程</text>
      </view>
    </view>

    <!-- 加载中骨架 -->
    <block wx:if="{{loading}}">
      <view class="trip-row anim-rise" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="thumb skeleton"></view>
        <view class="info">
          <view class="skeleton" style="width:70%;height:30rpx;border-radius:8rpx"></view>
          <view class="skeleton" style="width:50%;height:24rpx;border-radius:8rpx;margin-top:14rpx"></view>
        </view>
      </view>
    </block>

    <!-- 旅程列表 -->
    <block wx:if="{{!loading && trips.length !== 0}}">
      <view class="sec">
        <text class="h">我的旅程</text>
        <view class="more"><text>长按卡片可删除</text></view>
      </view>
      <view class="trip-row anim-rise" wx:for="{{trips}}" wx:key="id" hover-class="press" bindtap="openTrip" bindlongpress="removeTrip" data-id="{{item.id}}">
        <view class="thumb" style="background:{{item.color}};display:flex;align-items:center;justify-content:center;font-size:60rpx;color:#fff">
          <image wx:if="{{item.image}}" class="thumb-img" src="{{item.image}}" mode="aspectFill" />
          <text wx:else>{{item.emoji}}</text>
        </view>
        <view class="info">
          <text class="t">{{item.title}}</text>
          <text class="s">{{item.destination}} · {{item.range}}</text>
          <view class="tags">
            <text class="tag blue">安排 {{item.count}} 项</text>
          </view>
        </view>
        <view class="ic ic-right arrow"></view>
      </view>
    </block>

    <view class="bottom-space"></view>
  </scroll-view>

  <!-- 卡片编辑弹层：标题 / 图标 / 封面色 -->
  <view wx:if="{{editShow}}" class="sheet-mask" bindtap="closeEdit"></view>
  <view wx:if="{{editShow}}" class="sheet" catchtap="noop">
    <view class="grab"></view>
    <view class="edit-head"><text class="t">编辑旅程卡片</text><view class="x" hover-class="press" bindtap="closeEdit"><view class="ic ic-close"></view></view></view>
    <view class="edit-lab">旅程名称</view>
    <view class="input">
      <view class="ic ic-flag"></view>
      <input value="{{editTitle}}" maxlength="60" placeholder="旅程名称" placeholder-class="ph" bindinput="onEditTitle" style="flex:1;font-size:28rpx" />
    </view>
    <view class="edit-lab">图标</view>
    <view class="edit-chips">
      <view wx:for="{{emojis}}" wx:key="*this" class="edit-chip {{editEmoji === item ? 'on' : ''}}" hover-class="press" bindtap="onEditEmoji" data-em="{{item}}" style="font-size:36rpx">{{item}}</view>
    </view>
    <view class="edit-lab">封面颜色</view>
    <view class="edit-dots">
      <view wx:for="{{colors}}" wx:key="*this" class="edit-dot" style="background:{{item}};border:5rpx solid {{editColor === item ? '#182A3D' : 'transparent'}}" hover-class="press" bindtap="onEditColor" data-color="{{item}}">
        <view wx:if="{{editColor === item}}" class="ic ic-check" style="width:26rpx;height:26rpx;color:#fff"></view>
      </view>
    </view>
    <view class="btn btn-block" style="margin:28rpx 0 8rpx" hover-class="press" bindtap="saveEdit"><text>保存</text></view>
  </view>
</view>
