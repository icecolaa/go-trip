.overview { background: var(--bg); }

.photo-head { position: relative; height: 472rpx; flex: none; }
.photo-head .bg { width: 100%; height: 100%; }
.bg-edit {
  position: absolute; right: 24rpx; bottom: 24rpx; z-index: 20;
  width: 68rpx; height: 68rpx; border-radius: 50%;
  background: rgba(24,42,61,.35); border: 2rpx solid rgba(255,255,255,.25);
  display: flex; align-items: center; justify-content: center;
}
.bg-edit .ic { width: 34rpx; height: 34rpx; color: #fff; }
.photo-head .scrim {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(10,30,55,.42) 0%, rgba(10,30,55,0) 40%, rgba(10,30,55,.62) 100%);
}
.head-title { position: absolute; left: 32rpx; right: 32rpx; bottom: 104rpx; z-index: 5; display: flex; flex-direction: column; }
.chip-live {
  display: inline-flex; align-items: center; gap: 10rpx; align-self: flex-start;
  background: var(--yel400); color: #6B5200; font-size: 22rpx; font-weight: 800;
  border-radius: 999rpx; padding: 8rpx 20rpx; box-shadow: var(--sh-yellow);
}
.chip-live .i { width: 12rpx; height: 12rpx; border-radius: 50%; background: #E4572E; }
.head-title .t { font-size: 48rpx; font-weight: 900; color: #fff; margin-top: 16rpx; text-shadow: 0 4rpx 20rpx rgba(8,30,55,.5); }
.head-title .meta { display: flex; align-items: center; gap: 10rpx; color: #fff; opacity: .95; font-size: 25rpx; margin-top: 8rpx; }
.head-title .meta .ic { width: 26rpx; height: 26rpx; }
.head-title .div { opacity: .5; }

.member-wrap { position: relative; z-index: 10; margin: -64rpx 32rpx 0; }
.member-bar { display: flex; align-items: center; gap: 20rpx; padding: 22rpx 28rpx; }
.invite-add {
  width: 60rpx; height: 60rpx; border-radius: 50%; border: 3rpx dashed var(--yel500);
  background: var(--yel100); display: flex; align-items: center; justify-content: center;
  margin-left: -18rpx; flex: none;
}
.invite-add .ic { width: 26rpx; height: 26rpx; }
.invite-txt { font-size: 23rpx; color: var(--ink3); flex: 1; margin-left: 4rpx; }

.actions { display: flex; gap: 20rpx; margin: 24rpx 32rpx 0; }
.act {
  flex: 1; background: var(--card); border-radius: 32rpx; box-shadow: var(--sh-card);
  padding: 24rpx 0 20rpx; display: flex; flex-direction: column; align-items: center; gap: 12rpx; position: relative;
}
.act .big { width: 80rpx; height: 80rpx; border-radius: 28rpx; display: flex; align-items: center; justify-content: center; }
.act .big.blue { background: var(--sky100); }
.act .big .ic { width: 40rpx; height: 40rpx; }
.act .big.blue .ic { color: var(--sky500); }
.act text { font-size: 23rpx; font-weight: 600; color: var(--ink2); }
.bubble-tip {
  position: absolute; top: -14rpx; right: 16rpx; background: var(--red); color: #fff;
  font-size: 19rpx; font-weight: 700; border-radius: 999rpx; padding: 4rpx 12rpx; border: 4rpx solid #fff;
}

.ai-strip {
  margin: 24rpx 32rpx 0; display: flex; align-items: center; gap: 20rpx; padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #FFFDF4, #FFF6D9); border: 2rpx solid #FFE9A8; border-radius: 32rpx;
}
.ai-strip .face { width: 68rpx; height: 68rpx; border-radius: 50%; border: 4rpx solid #fff; box-shadow: 0 6rpx 16rpx rgba(255,196,20,.4); flex: none; }
.ai-strip .txt { flex: 1; font-size: 25rpx; color: #6B5200; line-height: 1.45; }
.ai-strip .ic { width: 28rpx; height: 28rpx; }

.progress-card { margin: 24rpx 32rpx 0; padding: 26rpx 30rpx; }
.progress-card .row { display: flex; justify-content: space-between; align-items: center; }
.progress-card .t { font-size: 27rpx; font-weight: 800; }
.progress-card .r { font-size: 22rpx; color: var(--ink3); }
.progress-card .progress { margin-top: 18rpx; }
.progress-card .tags { display: flex; gap: 12rpx; margin-top: 18rpx; flex-wrap: wrap; }

.day-card {
  display: flex; align-items: center; gap: 24rpx; background: var(--card);
  border-radius: 32rpx; box-shadow: var(--sh-card); padding: 24rpx 26rpx; margin: 0 32rpx 20rpx; position: relative;
}
.day-badge {
  width: 92rpx; height: 92rpx; border-radius: 28rpx; background: var(--sky100);
  display: flex; flex-direction: column; align-items: center; justify-content: center; flex: none;
}
.day-badge .b { font-size: 30rpx; font-weight: 900; color: var(--sky600); }
.day-badge .s { font-size: 18rpx; color: var(--sky500); font-weight: 600; }
.day-card.done .day-badge { background: #E4F6EC; }
.day-card.done .day-badge .b { color: #2FA96E; }
.day-card.today { border: 3rpx solid var(--yel400); box-shadow: 0 16rpx 40rpx rgba(255,196,20,.22); }
.day-card.today .day-badge { background: linear-gradient(135deg, #FFDE5C, var(--yel500)); }
.day-card.today .day-badge .b { color: #6B5200; }
.day-card.today .day-badge .s { color: #8A6D1A; }
.day-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.day-main .h { font-size: 29rpx; font-weight: 700; color: var(--ink); display: flex; align-items: center; gap: 12rpx; }
.day-main .h .ic { width: 28rpx; height: 28rpx; }
.day-main .s { font-size: 23rpx; color: var(--ink3); margin-top: 4rpx; }
.day-thumbs { display: flex; }
.day-thumbs image { width: 52rpx; height: 52rpx; border-radius: 16rpx; border: 3rpx solid #fff; margin-left: -14rpx; }
.day-thumbs image:first-child { margin-left: 0; }
.today-rib {
  position: absolute; top: -18rpx; right: 24rpx; background: var(--yel400); color: #6B5200;
  font-size: 20rpx; font-weight: 800; border-radius: 999rpx; padding: 5rpx 18rpx; box-shadow: var(--sh-yellow);
}

/* 进行中呼吸点：传达「实时状态」（有动机的循环动画） */
.chip-live .i { animation: pulse 1.8s ease-in-out infinite; }

/* 功能矩阵两行 */
.actions { flex-wrap: wrap; row-gap: 20rpx; }
.act { flex: none; width: calc((100% - 60rpx) / 4); }

/* 天气速览 */
.wx-strip { margin: 20rpx 32rpx 0; padding: 22rpx 24rpx; }
.wx-head { display: flex; align-items: baseline; margin-bottom: 14rpx; }
.wx-head .t { font-size: 27rpx; font-weight: 800; color: var(--ink); }
.wx-head .s { margin-left: auto; font-size: 21rpx; color: var(--ink3); }
.wx-days { display: flex; gap: 12rpx; }
.wx-day { flex: 1; background: var(--sky50); border-radius: 18rpx; padding: 14rpx 0; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.wx-day .d { font-size: 20rpx; color: var(--ink3); font-weight: 700; }
.wx-day .i { font-size: 30rpx; }
.wx-day .t2 { font-size: 20rpx; color: var(--ink2); font-weight: 700; }
.wx-day .t3 { font-size: 18rpx; color: var(--ink3); }

/* 出发模式 CTA */
.tm-cta {
  margin: 20rpx 32rpx 0; display: flex; align-items: center; gap: 20rpx; padding: 22rpx 24rpx;
  background: linear-gradient(135deg, #FFFDF4, #FFF3C8); border: 2rpx solid #FFE9A8; border-radius: 32rpx;
  box-shadow: 0 16rpx 40rpx rgba(255,196,20,.18);
}
.tm-cta-ic { width: 76rpx; height: 76rpx; border-radius: 24rpx; background: var(--yel400); display: flex; align-items: center; justify-content: center; flex: none; box-shadow: var(--sh-yellow); }
.tm-cta-ic .ic { width: 38rpx; height: 38rpx; color: #6B5200; }
.tm-cta-txt { flex: 1; display: flex; flex-direction: column; }
.tm-cta-txt .t { font-size: 28rpx; font-weight: 900; color: #6B5200; }
.tm-cta-txt .s { font-size: 21rpx; color: #A97E00; margin-top: 2rpx; }

/* 修改行程：hero 编辑钮 + 弹层 */
.bg-edit.edit { bottom: 104rpx; }
.edit-head { display: flex; align-items: center; justify-content: space-between; margin: 8rpx 0 20rpx; }
.edit-head .t { font-size: 33rpx; font-weight: 800; color: var(--ink); }
.edit-head .x { width: 52rpx; height: 52rpx; border-radius: 50%; background: var(--sky50); display: flex; align-items: center; justify-content: center; }
.edit-head .x .ic { width: 26rpx; height: 26rpx; color: var(--ink2); }
.edit-lab { font-size: 24rpx; font-weight: 700; color: var(--ink2); margin: 22rpx 0 12rpx; }
.edit-dates { display: flex; gap: 20rpx; }
.edit-dates .date-box {
  flex: 1; height: 88rpx; border-radius: 24rpx; background: var(--sky50);
  display: flex; align-items: center; padding: 0 24rpx; gap: 16rpx;
}
.edit-dates .date-box .lab { font-size: 24rpx; color: var(--ink3); font-weight: 600; flex: none; }
.edit-dates .date-box .d { font-size: 28rpx; font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; }
