.ledger .scroll { padding-bottom: 40rpx; }

.sum-card {
  margin: 12rpx 32rpx 0; padding: 32rpx; position: relative; overflow: hidden;
  background: linear-gradient(135deg, var(--sky400), var(--sky600)); border-radius: 40rpx;
  box-shadow: 0 24rpx 56rpx rgba(27,120,216,.35); color: #fff;
  display: flex; flex-direction: column;
}
.sum-card .arc {
  position: absolute; right: -40rpx; top: -32rpx; width: 400rpx; height: 260rpx;
  border: 5rpx dashed rgba(255,255,255,.5); border-bottom: none;
  border-radius: 50% 50% 0 0 / 100% 100% 0 0; opacity: .7;
}
.sum-card .lab { font-size: 23rpx; opacity: .85; }
.sum-card .amt-row { display: flex; align-items: baseline; gap: 16rpx; margin-top: 4rpx; }
.sum-card .amt { font-size: 68rpx; font-weight: 900; letter-spacing: 1rpx; }
.sum-card .yen { font-size: 30rpx; font-weight: 700; opacity: .85; }
.sum-card .avg { font-size: 26rpx; font-weight: 700; opacity: .85; }
.sum-card .row2 { display: flex; gap: 16rpx; margin-top: 28rpx; }
.sum-card .st {
  flex: 1; background: rgba(255,255,255,.16); border-radius: 24rpx;
  padding: 16rpx 20rpx; display: flex; flex-direction: column;
}
.sum-card .st .v { font-size: 29rpx; font-weight: 800; }
.sum-card .st .k { font-size: 20rpx; opacity: .85; margin-top: 2rpx; }
.sum-card .st.hl { background: rgba(255,210,63,.28); }
.sum-card .st.hl .v { color: #FFE9A8; }

.bal-strip { display: flex; gap: 16rpx; margin: 24rpx 32rpx 0; }
.bal {
  flex: 1; background: var(--card); border-radius: 28rpx; box-shadow: var(--sh-card);
  padding: 18rpx 0; display: flex; flex-direction: column; align-items: center;
}
.bal .avatar { width: 56rpx; height: 56rpx; font-size: 22rpx; margin-bottom: 10rpx; }
.bal .n { font-size: 25rpx; font-weight: 800; color: var(--ink); }
.bal .v { font-size: 19rpx; font-weight: 600; margin-top: 2rpx; }
.bal .pos { color: var(--green); }
.bal .neg { color: var(--red); }

.day-head { display: flex; align-items: baseline; gap: 16rpx; padding: 32rpx 36rpx 16rpx; }
.day-head .b { font-size: 27rpx; font-weight: 800; color: var(--ink); }
.day-head .s { font-size: 22rpx; color: var(--ink3); }

.bill {
  display: flex; align-items: center; gap: 22rpx; background: var(--card);
  border-radius: 28rpx; box-shadow: var(--sh-card); padding: 22rpx 26rpx; margin: 0 32rpx 18rpx;
}
.bill .cat { width: 80rpx; height: 80rpx; border-radius: 26rpx; display: flex; align-items: center; justify-content: center; flex: none; }
.bill .cat .ic { width: 38rpx; height: 38rpx; }
.bill .cat.sky { background: var(--sky100); }
.bill .cat.yel { background: var(--yel100); }
.bill .cat.grn { background: #E4F6EC; }
.bill .cat.tea { background: #E0F4F4; }
.b-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.b-main .t { font-size: 28rpx; font-weight: 700; color: var(--ink); }
.b-main .s { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: var(--ink3); margin-top: 4rpx; }
.b-main .avatar.sm { width: 30rpx; height: 30rpx; font-size: 16rpx; border-width: 2rpx; }
.bill .amt { font-size: 30rpx; font-weight: 800; color: var(--ink); }

.more-link { display: block; text-align: center; font-size: 24rpx; color: var(--ink3); padding: 12rpx 0 0; }

/* 记一笔弹层 */
.bill-sheet { height: 1272rpx; display: flex; flex-direction: column; padding-top: 12rpx; }
.bill-sheet .head { display: flex; align-items: center; padding-bottom: 12rpx; }
.bill-sheet .head .t { font-size: 36rpx; font-weight: 900; color: var(--ink); margin-right: 20rpx; }
.bill-sheet .head .save { margin-right: 20rpx; background: linear-gradient(135deg, var(--sky400), var(--sky600)); color: #fff; }
.bill-sheet .head .x { width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--bg); display: flex; align-items: center; justify-content: center; }
.bill-sheet .head .x .ic { width: 26rpx; height: 26rpx; color: var(--ink3); }

.amt-box { display: flex; align-items: center; justify-content: flex-end; gap: 8rpx; padding: 8rpx 8rpx 24rpx; border-bottom: 2rpx dashed var(--line); }
.amt-box .yen { font-size: 40rpx; font-weight: 800; color: var(--ink3); }
.amt-box .v { font-size: 76rpx; font-weight: 900; color: var(--ink); letter-spacing: 1rpx; }

.f-lab { display: block; font-size: 23rpx; color: var(--ink3); font-weight: 600; margin: 22rpx 0 14rpx; }
.cats { display: flex; justify-content: space-between; }
.cat-c, .cats .cat { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.cats .cat .ci { width: 84rpx; height: 84rpx; border-radius: 50%; background: var(--bg); display: flex; align-items: center; justify-content: center; }
.cats .cat .ci .ic { width: 36rpx; height: 36rpx; color: var(--ink2); }
.cats .cat text { font-size: 20rpx; color: var(--ink3); }
.cats .cat.on .ci { background: linear-gradient(135deg, #FFDE5C, var(--yel500)); box-shadow: var(--sh-yellow); }
.cats .cat.on .ci .ic { color: #6B5200; }
.cats .cat.on text { color: #B8860B; font-weight: 700; }

.payers { display: flex; gap: 16rpx; flex-wrap: wrap; }
.payer {
  display: flex; align-items: center; gap: 10rpx; border: 2rpx solid var(--line);
  border-radius: 999rpx; padding: 8rpx 20rpx 8rpx 8rpx; background: var(--card);
}
.payer .avatar.sm { width: 44rpx; height: 44rpx; font-size: 19rpx; border-width: 0; }
.payer text { font-size: 23rpx; color: var(--ink2); font-weight: 600; }
.payer.on { border-color: var(--sky400); background: var(--sky50); }
.payer.on text { color: var(--sky700); }

.split-row { display: flex; align-items: center; gap: 16rpx; }
.split-row .seg { flex: 1; }
.split-note {
  flex: none; background: var(--yel100); border-radius: 20rpx; padding: 12rpx 18rpx;
  font-size: 20rpx; color: #B8860B; font-weight: 700; line-height: 1.4; text-align: center;
}

.keypad { margin-top: auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; padding: 20rpx 0 8rpx; }
.key {
  height: 88rpx; border-radius: 24rpx; background: var(--bg);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 600; color: var(--ink);
}
.key .ic { width: 40rpx; height: 40rpx; }

/* 预算与分类统计 */
.budget-card { margin: 20rpx 32rpx 0; padding: 24rpx 28rpx; }
.b-row { display: flex; justify-content: space-between; align-items: baseline; }
.b-row .t { font-size: 27rpx; font-weight: 800; color: var(--ink); }
.b-row .r { font-size: 23rpx; color: var(--ink2); font-weight: 700; }
.budget-card .progress { margin-top: 16rpx; }
.b-note { display: block; font-size: 20rpx; color: var(--ink3); margin-top: 10rpx; }
.cat-stats { margin-top: 20rpx; border-top: 2rpx dashed var(--line); padding-top: 8rpx; }
.cs-row { display: flex; align-items: center; gap: 16rpx; padding: 10rpx 0; }
.cs-name { width: 80rpx; font-size: 23rpx; color: var(--ink2); font-weight: 600; flex: none; }
.cs-track { flex: 1; height: 12rpx; border-radius: 6rpx; background: var(--sky50); overflow: hidden; }
.cs-bar { height: 100%; border-radius: 6rpx; transition: width .3s ease; }
.cs-amt { width: 120rpx; text-align: right; font-size: 22rpx; color: var(--ink2); flex: none; }
.settle-cta { margin: 8rpx 32rpx 0; height: 88rpx; }
