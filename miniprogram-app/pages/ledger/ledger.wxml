<!-- AA 记账本：预算进度 / 分类统计 / 人均消耗 / 记一笔弹层 -->
<view class="screen ledger {{themeClass}}">
  <nav-bar float="{{true}}" back="{{true}}" />

  <scroll-view class="scroll" scroll-y>
    <view wx:if="{{noTrip}}" class="anim-rise" style="padding:140rpx 40rpx;text-align:center;">
      <text style="font-size:30rpx;color:var(--ink3)">请先从首页选择行程</text>
    </view>
    <block wx:else>
    <view class="sum-card anim-rise">
      <view class="arc"></view>
      <text class="lab">行程总支出 · {{billList.length}} 笔</text>
      <view class="amt-row">
        <text class="amt"><text class="yen">¥ </text>{{totalSpent}}</text>
        <text class="avg">人均 ¥{{perPerson}}</text>
      </view>
      <view class="row2">
        <view class="st" wx:for="{{balances}}" wx:key="name">
          <text class="v">{{item.val}}</text>
          <text class="k">{{item.name}}{{item.neg ? '待付' : '应收'}}</text>
        </view>
      </view>
    </view>

    <!-- 预算进度条 + 分类统计 -->
    <view class="card budget-card anim-rise d1">
      <view class="b-row">
        <text class="t">团队预算</text>
        <text class="r num">¥{{totalSpent}} / ¥{{budgetTotal}}</text>
      </view>
      <view class="progress"><view class="bar" style="width:{{budgetPct}}%"></view></view>
      <text class="b-note">已消耗 {{budgetPct}}%{{budgetPct > 85 ? ' · 快超预算了' : ' · 余量充足'}}</text>

      <view class="cat-stats">
        <view class="cs-row" wx:for="{{catStats}}" wx:key="name">
          <text class="cs-name">{{item.name}}</text>
          <view class="cs-track"><view class="cs-bar" style="width:{{item.pct}}%;background:{{item.color}}"></view></view>
          <text class="cs-amt num">¥{{item.amount}}</text>
        </view>
      </view>
    </view>

    <view class="bal-strip anim-rise d2">
      <view class="bal" wx:for="{{balances}}" wx:key="name">
        <view class="avatar {{item.av}}">{{item.initial}}</view>
        <text class="n">{{item.name}}</text>
        <text class="v {{item.neg ? 'neg' : 'pos'}}">{{item.val}}</text>
      </view>
    </view>

    <view class="day-head"><text class="b">全部账单</text><text class="s">点「智能结算」生成最少转账</text></view>
    <view class="bill anim-rise" style="animation-delay:{{index * 60}}ms" wx:for="{{billList}}" wx:key="id"
          hover-class="press" bindlongpress="delBill" data-id="{{item.id}}" data-title="{{item.title}}">
      <view class="cat {{item.catBg}}"><view class="ic ic-{{item.catIcon}}" style="color:{{item.catColor}}"></view></view>
      <view class="b-main">
        <text class="t">{{item.title}}</text>
        <view class="s">
          <view class="avatar {{item.payerAv}} sm">{{item.payerInitial}}</view>
          <text>{{item.payer}}垫付 · {{item.split}} · {{item.dayTxt}}</text>
        </view>
      </view>
      <text class="amt num">{{item.amountTxt}}</text>
    </view>

    <view class="settle-cta btn" hover-class="press" bindtap="goSettle">
      <text>最少转账结算</text>
      <view class="ic ic-right" style="width:28rpx;height:28rpx"></view>
    </view>
    <view style="height:calc(200rpx + env(safe-area-inset-bottom))"></view>
    </block>
  </scroll-view>

  <view class="fab" style="bottom:120rpx" hover-class="press" bindtap="openSheet">
    <view class="ic ic-plus"></view><text>记一笔</text>
  </view>

  <!-- 记一笔 弹层 -->
  <view wx:if="{{sheet}}" class="sheet-mask" bindtap="closeSheet"></view>
  <view wx:if="{{sheet}}" class="sheet bill-sheet">
    <view class="grab"></view>
    <view class="head">
      <text class="t">记一笔</text>
      <text class="tag gray">{{sheetDate}}</text>
      <view class="btn small save" hover-class="press" bindtap="save"><text>保存</text></view>
      <view class="x" hover-class="press" bindtap="closeSheet"><view class="ic ic-close"></view></view>
    </view>

    <view class="amt-box">
      <text class="yen">¥</text>
      <text class="v">{{amount}}</text>
    </view>

    <text class="f-lab">分类</text>
    <view class="cats">
      <view class="cat {{catIdx === index ? 'on' : ''}}" hover-class="press" wx:for="{{cats}}" wx:key="name" bindtap="setCat" data-i="{{index}}">
        <view class="ci"><view class="ic ic-{{item.icon}}"></view></view>
        <text>{{item.name}}</text>
      </view>
    </view>

    <text class="f-lab">谁垫付的</text>
    <view class="payers">
      <view class="payer {{payerIdx === index ? 'on' : ''}}" hover-class="press" wx:for="{{payers}}" wx:key="name" bindtap="setPayer" data-i="{{index}}">
        <view class="avatar {{item.av}} sm">{{item.initial}}</view>
        <text>{{item.name}}</text>
      </view>
    </view>

    <text class="f-lab">分摊方式</text>
    <view class="split-row">
      <view class="seg">
        <view class="it on"><text>平均</text></view>
        <view class="it"><text>按比例</text></view>
        <view class="it"><text>指定人</text></view>
      </view>
      <view class="split-note"><text>默认全员均摊\n保存后计入统计</text></view>
    </view>

    <view class="keypad">
      <view class="key" hover-class="press" wx:for="{{keys}}" wx:key="*this" bindtap="pressKey" data-k="{{item}}">
        <text wx:if="{{item !== 'del'}}">{{item}}</text>
        <view wx:else class="ic ic-back" style="color:#51637A"></view>
      </view>
    </view>
  </view>
</view>
