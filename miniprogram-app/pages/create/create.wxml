<!-- 新建旅程：基本信息 → 出行时间 → 封面 -->
<view class="screen create {{themeClass}}">
  <nav-bar float="{{true}}" back="{{true}}" />

  <view class="scroll" style="overflow-y:auto">
    <view class="steps">
      <view class="step on"><view class="n">1</view><text>基本信息</text></view>
      <view class="line"></view>
      <view class="step on"><view class="n">2</view><text>出行时间</text></view>
      <view class="line"></view>
      <view class="step on"><view class="n">3</view><text>挑选封面</text></view>
    </view>

    <!-- 基本信息 -->
    <view class="card" style="margin:8rpx 32rpx 0;padding:28rpx 32rpx;display:flex;flex-direction:column;gap:26rpx">
      <view>
        <text class="t-sub" style="font-weight:700;color:var(--ink)">旅程名称</text>
        <view class="input" style="margin-top:14rpx">
          <view class="ic ic-flag"></view>
          <input value="{{title}}" maxlength="60" placeholder="如：国庆伊春赏秋之旅" placeholder-class="ph" bindinput="onTitle" style="flex:1;font-size:28rpx" />
        </view>
        <text class="t-cap" style="display:block;margin-top:8rpx;text-align:right">{{title.length}}/60</text>
      </view>
      <view>
        <text class="t-sub" style="font-weight:700;color:var(--ink)">目的地</text>
        <view class="input" style="margin-top:14rpx">
          <view class="ic ic-pin"></view>
          <input value="{{destination}}" maxlength="40" placeholder="如：伊春（选填）" placeholder-class="ph" bindinput="onDestination" style="flex:1;font-size:28rpx" />
        </view>
        <text class="t-cap" style="display:block;margin-top:8rpx;text-align:right">{{destination.length}}/40</text>
      </view>
      <view>
        <text class="t-sub" style="font-weight:700;color:var(--ink)">预算（¥，选填）</text>
        <view class="input" style="margin-top:14rpx">
          <view class="ic ic-wallet"></view>
          <input value="{{budget}}" type="digit" placeholder="本程大概花多少" placeholder-class="ph" bindinput="onBudget" style="flex:1;font-size:28rpx" />
        </view>
      </view>
    </view>

    <!-- 出行时间 -->
    <view class="card date-card">
      <view class="date-head">
        <view class="ic ic-cal" style="color:#2E92ED"></view>
        <text class="t">出行时间</text>
        <text class="tag yellow" style="margin-left:auto">{{nights > 0 ? '共 ' + (nights + 1) + ' 天 ' + nights + ' 晚' : '请选择日期'}}</text>
      </view>
      <view class="date-row">
        <picker mode="date" value="{{startDate}}" end="{{endDate}}" bindchange="onStart" style="flex:1">
          <view class="date-box">
            <text class="lab">出发</text>
            <text class="d">{{startCn}}</text>
            <text class="w">{{startWeek || '点击选择'}}</text>
          </view>
        </picker>
        <view class="date-arrow"><view class="ic ic-right" style="color:#1B78D8"></view></view>
        <picker mode="date" value="{{endDate}}" start="{{startDate}}" bindchange="onEnd" style="flex:1">
          <view class="date-box right">
            <text class="lab">返程</text>
            <text class="d">{{endCn}}</text>
            <text class="w">{{endWeek || '点击选择'}}</text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 封面 emoji -->
    <view class="sec"><text class="h">封面图标</text><text class="t-cap">选一个当封面</text></view>
    <view class="chips px32" style="flex-wrap:wrap">
      <view wx:for="{{emojis}}" wx:key="*this" class="chip {{emoji === item ? 'on' : ''}}" hover-class="press" bindtap="onEmoji" data-em="{{item}}" style="font-size:36rpx;padding:0 26rpx">{{item}}</view>
    </view>

    <!-- 封面颜色 -->
    <view class="sec"><text class="h">封面颜色</text><text class="t-cap">搭配图标更出片</text></view>
    <view class="px32" style="display:flex;gap:28rpx;flex-wrap:wrap;padding-bottom:8rpx">
      <view wx:for="{{colors}}" wx:key="*this" hover-class="press" bindtap="onColor" data-color="{{item}}"
        style="width:60rpx;height:60rpx;border-radius:50%;background:{{item}};display:flex;align-items:center;justify-content:center;border:5rpx solid {{color === item ? '#182A3D' : 'rgba(255,255,255,.9)'}};box-shadow:0 6rpx 16rpx rgba(23,84,153,.18)">
        <view wx:if="{{color === item}}" class="ic ic-check" style="width:28rpx;height:28rpx;color:#fff"></view>
      </view>
    </view>

    <view class="cta-space"></view>
  </view>

  <view class="bottom-cta">
    <view class="btn btn-block {{submitting ? 'ghost' : ''}}" hover-class="press" bindtap="submit">
      <text>{{submitting ? '创建中…' : '创建旅程'}}</text>
      <view wx:if="{{!submitting}}" class="ic ic-right" style="width:28rpx;height:28rpx"></view>
    </view>
  </view>
</view>
