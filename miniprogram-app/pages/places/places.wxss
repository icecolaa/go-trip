.places .scroll { padding-bottom: 40rpx; }
.search-wrap { padding: 8rpx 32rpx 0; }
.input .hot { margin-left: auto; }
.px32 { padding: 24rpx 32rpx 0; }

.sort-row { display: flex; align-items: center; padding: 4rpx 32rpx 16rpx; font-size: 23rpx; color: var(--ink3); }
.sort-row .b { color: var(--ink2); font-weight: 600; margin-right: 8rpx; }
.sort-row .ic { width: 24rpx; height: 24rpx; margin-left: 6rpx; }

.poi-card {
  display: flex; gap: 24rpx; background: var(--card); border-radius: 32rpx;
  box-shadow: var(--sh-card); padding: 22rpx; margin: 0 32rpx 22rpx;
}
.ph-wrap { position: relative; flex: none; }
.ph { width: 192rpx; height: 192rpx; border-radius: 24rpx; }
.rk {
  position: absolute; left: 0; top: 0; background: rgba(24,42,61,.62); color: #fff;
  font-size: 19rpx; font-weight: 700; border-radius: 24rpx 0 20rpx 0; padding: 4rpx 14rpx;
}
.info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.name { font-size: 30rpx; font-weight: 800; color: var(--ink); }
.rate { display: flex; align-items: center; gap: 8rpx; margin-top: 8rpx; }
.rate .ic { width: 26rpx; height: 26rpx; }
.rate .score { color: #E0A800; font-weight: 800; font-size: 24rpx; }
.rate .desc { color: var(--ink3); font-size: 22rpx; }
.meta { display: flex; gap: 10rpx; margin-top: 12rpx; flex-wrap: wrap; }
.foot { display: flex; align-items: center; margin-top: auto; padding-top: 12rpx; }
.price { font-size: 24rpx; color: var(--ink2); }
.add-btn, .added-btn {
  margin-left: auto; display: flex; align-items: center; gap: 8rpx; height: 56rpx;
  padding: 0 24rpx; border-radius: 28rpx; font-size: 24rpx;
}
.add-btn { background: linear-gradient(135deg, #FFDE5C, var(--yel500)); color: #6B5200; font-weight: 800; box-shadow: 0 8rpx 20rpx rgba(255,196,20,.35); }
.added-btn { background: var(--sky100); color: var(--sky600); font-weight: 700; }
.add-btn .ic, .added-btn .ic { width: 24rpx; height: 24rpx; }

.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 35; background: var(--card);
  border-radius: 40rpx 40rpx 0 0; box-shadow: 0 -16rpx 48rpx rgba(23,84,153,.10);
  padding: 24rpx 32rpx calc(42rpx + env(safe-area-inset-bottom));
  display: flex; align-items: center; gap: 24rpx;
}
.sel { display: flex; flex-direction: column; }
.sel .n { font-size: 34rpx; font-weight: 900; color: var(--sky600); }
.sel .s { font-size: 23rpx; color: var(--ink3); margin-top: 2rpx; }
.grow { flex: 1; height: 92rpx; }
