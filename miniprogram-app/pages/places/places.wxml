<!-- 候选地点库：收藏 → 排入行程 -->
<view class="screen places {{themeClass}}">
  <nav-bar float="{{true}}" back="{{true}}" />

  <!-- 无行程空态 -->
  <view wx:if="{{!hasTrip}}" style="margin:200rpx 32rpx">
    <view class="card" style="padding:64rpx 40rpx;display:flex;flex-direction:column;align-items:center;gap:16rpx">
      <text class="t-sec">还没有选定行程</text>
      <text class="t-sub">请先从首页选择行程</text>
    </view>
  </view>

  <scroll-view class="scroll" scroll-y wx:if="{{hasTrip}}">
    <view class="search-wrap">
      <view class="input" hover-class="press" bindtap="onAdd">
        <view class="ic ic-search"></view>
        <text class="ph">添加候选地点…</text>
        <text class="tag yellow hot">{{city}}</text>
      </view>
    </view>

    <view class="sort-row">
      <text class="b">共 {{placeCount}} 个地点</text>
      <text>· 其中 {{candidateCount}} 个候选待排入</text>
      <view class="ic ic-right"></view>
    </view>

    <view wx:if="{{!places.length}}" style="padding:60rpx 32rpx;display:flex;flex-direction:column;align-items:center;gap:16rpx">
      <text style="color:#93A5B8;font-size:26rpx">还没有候选地点</text>
      <view class="btn small yellow" hover-class="press" bindtap="onAdd"><text>添加第一个地点</text></view>
    </view>

    <view class="poi-card anim-rise" style="animation-delay:{{index * 70}}ms" wx:for="{{places}}" wx:key="id"
          bindlongpress="onDelete" data-id="{{item.id}}">
      <view class="ph-wrap">
        <image class="ph" src="{{item.img}}" mode="aspectFill" lazy-load />
        <view class="rk">No.{{item.rank}}</view>
      </view>
      <view class="info">
        <text class="name">{{item.name}}</text>
        <view class="rate">
          <text class="desc">{{item.desc}}</text>
        </view>
        <view class="meta">
          <text class="tag blue">{{item.t1}}</text>
          <text class="tag gray" wx:if="{{item.t2}}">{{item.t2}}</text>
          <text class="tag {{item.t3c}}">{{item.t3}}</text>
        </view>
        <view class="foot">
          <text class="price">{{item.footTxt}}</text>
          <text catchtap="onDelete" data-id="{{item.id}}" style="font-size:22rpx;color:#93A5B8;padding:0 12rpx">删除</text>
          <view wx:if="{{item.candidate}}" class="add-btn" hover-class="press" bindtap="onAddToTrip" data-id="{{item.id}}">
            <view class="ic ic-plus"></view>
            <text>加入行程</text>
          </view>
          <view wx:else class="added-btn" hover-class="press" bindtap="goSchedule">
            <view class="ic ic-check"></view>
            <text>查看日程</text>
          </view>
        </view>
      </view>
    </view>
    <view style="height:calc(200rpx + env(safe-area-inset-bottom))"></view>
  </scroll-view>

  <view class="bottom-bar" wx:if="{{hasTrip}}">
    <view class="sel">
      <text class="n">{{candidateCount}}</text>
      <text class="s">候选地点 · 长按卡片删除</text>
    </view>
    <view class="btn grow" hover-class="press" bindtap="goSchedule"><text>查看日程安排</text></view>
  </view>
</view>
