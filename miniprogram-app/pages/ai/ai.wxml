<!-- 行程助手：对话 / 解析攻略 / 生成行程 -->
<view class="screen aiscreen {{themeClass}}">
  <nav-bar>
    <view class="ai-id">
      <image class="face" src="/assets/logo.png" mode="aspectFill" />
      <view class="t">
        <text class="n">行程助手</text>
        <view class="st"><view class="i"></view><text>{{engineTag}} · 懂你的旅行搭子</text></view>
      </view>
    </view>
  </nav-bar>

  <view class="mode-seg">
    <view class="it {{mode === 'chat' ? 'on' : ''}}" hover-class="press" bindtap="setMode" data-m="chat"><text>对话</text></view>
    <view class="it {{mode === 'parse' ? 'on' : ''}}" hover-class="press" bindtap="setMode" data-m="parse"><text>解析攻略</text></view>
    <view class="it {{mode === 'gen' ? 'on' : ''}}" hover-class="press" bindtap="setMode" data-m="gen"><text>生成行程</text></view>
  </view>

  <!-- 对话模式 -->
  <block wx:if="{{mode === 'chat'}}">
    <scroll-view class="chat-area" scroll-y scroll-into-view="{{lastId}}" scroll-with-animation>
      <view class="msg" wx:for="{{messages}}" wx:key="id" id="m{{item.id}}">
        <view wx:if="{{item.role === 'ai'}}" class="avatar ai"><image src="/assets/logo.png" mode="aspectFill" /></view>
        <view wx:else class="avatar av-blue">我</view>
        <view class="bubble {{item.role === 'me' ? 'me-bubble' : ''}}">{{item.text}}</view>
      </view>
      <view id="pageend" style="height:20rpx"></view>
    </scroll-view>

    <view class="chat-input">
      <view class="chip-rail">
        <view class="c" hover-class="press" bindtap="quick" data-q="帮我安排 3 天行程"><view class="ic ic-route"></view><text>帮我安排 3 天行程</text></view>
        <view class="c" hover-class="press" bindtap="quick" data-q="记账怎么分摊"><view class="ic ic-wallet"></view><text>记账怎么分摊</text></view>
        <view class="c" hover-class="press" bindtap="quick" data-q="行李要带什么"><view class="ic ic-list"></view><text>行李要带什么</text></view>
        <view class="c" hover-class="press" bindtap="quick" data-q="当地有什么好吃的"><view class="ic ic-food"></view><text>当地有什么好吃的</text></view>
      </view>
      <view class="input-row">
        <input class="field" value="{{draft}}" placeholder="问问任何旅行计划的问题…" placeholder-class="ph" show-confirm-bar="{{false}}"
               confirm-type="send" cursor-spacing="24" bindinput="onInput" bindconfirm="send" />
        <view class="send" hover-class="press" bindtap="send"><view class="ic ic-send" style="color:#fff"></view></view>
      </view>
    </view>
  </block>

  <!-- 解析攻略模式 -->
  <block wx:if="{{mode === 'parse'}}">
    <view class="tool-area">
      <view class="tool-card card anim-rise">
        <text class="tool-lab">粘贴小红书 / 公众号攻略文本</text>
        <textarea class="tool-textarea" value="{{pasteText}}" placeholder="支持 D1/D2、第X天 等格式，逐行一个地点…" placeholder-class="ph"
                  bindinput="onPaste" maxlength="2000" />
        <view class="btn btn-block" hover-class="press" bindtap="doParse"><text>{{parseBusy ? '解析中…' : '生成预览'}}</text></view>
      </view>

      <view class="it-card-wrap" wx:if="{{parsed}}">
        <view class="itinerary-card wide">
          <view class="hd">
            <text class="t">解析预览 · {{parsed.days.length}} 天</text>
            <text class="s">{{parsed.source === 'builtin' ? '内置规则' : '云端生成'}}</text>
          </view>
          <view class="it-row" wx:for="{{parsed.days}}" wx:key="title">
            <view class="d"><text class="b">D{{index + 1}}</text></view>
            <view class="it-t">
              <text class="b">{{item.title}}</text>
              <text class="s">{{item.stops}}</text>
            </view>
          </view>
          <view class="it-foot">
            <text class="est">此处仅生成预览 · 确认内容后可在行程日程中添加地点</text>
          </view>
        </view>
      </view>
      <view style="height:40rpx"></view>
    </view>
  </block>

  <!-- 生成行程模式 -->
  <block wx:if="{{mode === 'gen'}}">
    <view class="tool-area">
      <view class="tool-card card anim-rise">
        <view class="gen-row">
          <view class="gen-field">
            <text class="lab">目的地</text>
            <input class="gen-input" value="{{gen.dest}}" bindinput="onGenDest" placeholder="如 成都" placeholder-class="ph" />
          </view>
          <view class="gen-field sm">
            <text class="lab">天数</text>
            <picker range="{{[1,2,3,4,5,6,7]}}" value="{{gen.days - 1}}" bindchange="onGenDays">
              <view class="gen-val">{{gen.days}} 天</view>
            </picker>
          </view>
          <view class="gen-field sm">
            <text class="lab">节奏</text>
            <picker range="{{['紧凑','适中','松弛']}}" bindchange="onGenPace">
              <view class="gen-val">{{gen.pace}}</view>
            </picker>
          </view>
        </view>
        <text class="tool-lab">偏好（可多选）</text>
        <view class="pref-chips">
          <view class="chip {{gen.prefs.indexOf(item) >= 0 ? 'on' : ''}}" wx:for="{{prefOptions}}" wx:key="*this"
                hover-class="press" bindtap="togglePref" data-p="{{item}}">{{item}}</view>
        </view>
        <view class="btn yellow btn-block" hover-class="press" bindtap="doGenerate"><text>{{genBusy ? '生成中…' : '生成行程草案'}}</text></view>
      </view>

      <view class="it-card-wrap" wx:if="{{generated}}">
        <view class="itinerary-card wide">
          <view class="hd">
            <text class="t">{{generated.days.length}} 日行程预览</text>
            <text class="s">{{generated.source === 'builtin' ? '内置规则' : '云端生成'}}</text>
          </view>
          <view class="it-row" wx:for="{{generated.days}}" wx:key="title">
            <view class="d"><text class="b">D{{index + 1}}</text></view>
            <view class="it-t">
              <text class="b">{{item.title}}</text>
              <text class="s">{{item.stops}}</text>
            </view>
          </view>
          <view class="it-foot">
            <text class="est">此处仅生成预览 · 确认内容后可在行程日程中添加地点</text>
          </view>
        </view>
      </view>
      <view style="height:40rpx"></view>
    </view>
  </block>
</view>
