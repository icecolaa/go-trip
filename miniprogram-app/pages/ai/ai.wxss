.aiscreen { background: linear-gradient(180deg, #EAF4FE 0%, var(--bg) 480rpx); }

.ai-id { display: flex; align-items: center; gap: 18rpx; }
.ai-id .face { width: 64rpx; height: 64rpx; border-radius: 50%; border: 4rpx solid #fff; box-shadow: 0 6rpx 20rpx rgba(255,196,20,.4); }
.ai-id .t { display: flex; flex-direction: column; }
.ai-id .n { font-size: 32rpx; font-weight: 800; color: var(--ink); line-height: 1.2; }
.ai-id .st { display: flex; align-items: center; gap: 8rpx; font-size: 20rpx; color: var(--green); margin-top: 2rpx; }
.ai-id .st .i { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--green); }

.chat-area { flex: 1; overflow: hidden; padding: 20rpx 28rpx 0; box-sizing: border-box; }

.avatar.ai { background: linear-gradient(135deg, #FFDE5C, #54A6F0); overflow: hidden; }
.avatar.ai image { width: 100%; height: 100%; border-radius: 50%; }
.bubble.me-bubble { background: linear-gradient(135deg, var(--sky400), var(--sky600)); color: #fff; border-radius: 32rpx 8rpx 32rpx 32rpx; box-shadow: 0 12rpx 32rpx rgba(46,146,237,.28); }

.it-card-wrap { display: flex; flex-direction: row-reverse; padding-left: 80rpx; margin-bottom: 28rpx; }
.itinerary-card {
  border-radius: 32rpx; border: 2rpx solid var(--sky100); overflow: hidden;
  background: var(--card); box-shadow: var(--sh-card); width: 524rpx;
  display: flex; flex-direction: column;
}
.itinerary-card .hd { background: linear-gradient(135deg, var(--sky400), var(--sky600)); padding: 20rpx 26rpx; display: flex; flex-direction: column; }
.itinerary-card .hd .t { color: #fff; font-size: 27rpx; font-weight: 800; }
.itinerary-card .hd .s { color: #fff; opacity: .85; font-size: 20rpx; margin-top: 2rpx; }
.it-row { display: flex; align-items: center; gap: 18rpx; padding: 18rpx 26rpx; border-top: 2rpx solid var(--sky50); }
.it-row .d {
  width: 60rpx; height: 60rpx; border-radius: 20rpx; background: var(--sky100);
  display: flex; flex-direction: column; align-items: center; justify-content: center; flex: none;
}
.it-row .d .b { font-size: 22rpx; font-weight: 900; color: var(--sky600); line-height: 1; }
.it-row .d .s { font-size: 16rpx; color: var(--sky500); }
.it-t { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.it-t .b { font-size: 25rpx; font-weight: 700; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.it-t .s { font-size: 20rpx; color: var(--ink3); }
.it-foot { display: flex; align-items: center; gap: 12rpx; background: var(--yel100); padding: 16rpx 26rpx; border-top: 2rpx solid #FFE9A8; }
.it-foot .est { font-size: 21rpx; color: #B8860B; font-weight: 700; }
.adopt {
  margin-left: auto; background: linear-gradient(135deg, #FFDE5C, var(--yel500));
  color: #6B5200; font-size: 22rpx; font-weight: 800; border-radius: 26rpx; padding: 10rpx 24rpx;
}

.chat-input { flex: none; display: flex; flex-direction: column; }
.chip-rail { display: flex; gap: 14rpx; padding: 0 24rpx 16rpx; overflow: hidden; }
.chip-rail .c {
  flex: none; display: flex; align-items: center; gap: 8rpx; background: var(--card);
  border: 2rpx solid var(--line); border-radius: 999rpx; padding: 12rpx 22rpx;
  font-size: 22rpx; color: var(--ink2); font-weight: 600;
}
.chip-rail .c .ic { width: 22rpx; height: 22rpx; color: var(--sky500); }
.input-row { display: flex; align-items: center; gap: 20rpx; padding: 0 24rpx; padding-bottom: calc(18rpx + env(safe-area-inset-bottom)); }
.field {
  flex: 1; height: 76rpx; border-radius: 38rpx; background: var(--bg);
  padding: 0 28rpx; font-size: 26rpx; color: var(--ink);
}
.ph { color: var(--ink3); }
.send {
  width: 76rpx; height: 76rpx; border-radius: 50%;
  background: linear-gradient(135deg, var(--sky400), var(--sky600));
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(46,146,237,.35); flex: none;
}
.send .ic { width: 34rpx; height: 34rpx; }

/* 新消息气泡入场（append 时自动触发）：对话反馈 */
.msg { animation: popIn 0.38s cubic-bezier(0.16, 1, 0.3, 1) both; }
.it-card-wrap { animation: popIn 0.42s cubic-bezier(0.16, 1, 0.3, 1) both; }

/* 模式切换 seg */
.mode-seg { flex: none; display: flex; background: var(--sky100); border-radius: 34rpx; padding: 6rpx; margin: 8rpx 32rpx 12rpx; }
.mode-seg .it { flex: 1; text-align: center; font-size: 25rpx; font-weight: 600; color: var(--ink2); padding: 12rpx 0; border-radius: 28rpx; }
.mode-seg .it.on { background: var(--card); color: var(--sky600); font-weight: 800; box-shadow: 0 4rpx 12rpx rgba(23,84,153,.14); }

/* 工具模式（解析/生成） */
.tool-area { flex: 1; overflow: hidden; padding: 8rpx 32rpx 0; box-sizing: border-box; }
.tool-card { padding: 24rpx 26rpx; }
.tool-lab { display: block; font-size: 23rpx; color: var(--ink3); font-weight: 600; margin-bottom: 12rpx; }
.tool-textarea { width: 100%; height: 260rpx; background: var(--bg); border-radius: 24rpx; padding: 20rpx 24rpx; font-size: 26rpx; color: var(--ink); box-sizing: border-box; margin-bottom: 20rpx; }
.gen-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.gen-field { flex: 1; display: flex; flex-direction: column; }
.gen-field.sm { flex: 0.8; }
.gen-input { height: 64rpx; background: var(--bg); border-radius: 18rpx; padding: 0 20rpx; font-size: 28rpx; font-weight: 800; color: var(--ink); }
.gen-val { height: 64rpx; line-height: 64rpx; background: var(--bg); border-radius: 18rpx; padding: 0 20rpx; font-size: 26rpx; font-weight: 800; color: var(--ink); }
.pref-chips { display: flex; gap: 14rpx; flex-wrap: wrap; margin-bottom: 22rpx; }
.itinerary-card.wide { width: 100%; }
