/* ============================================================
   出发吧 GoTrip · 设计系统 app.wxss
   由 gotrip-ui/css/gotrip.css 全量翻译：px→rpx(×2)
   框架件（状态栏/导航/胶囊/TabBar）在 components/nav-bar 与
   custom-tab-bar 中实现，此处为全局设计令牌 + 通用组件库。
   ============================================================ */

page {
  /* 天空蓝 ramp */
  --sky50: #F1F8FE; --sky100: #E3F0FD; --sky200: #C6E2FB; --sky300: #93CBF7;
  --sky400: #55ACF3; --sky500: #2E92ED; --sky600: #1B78D8; --sky700: #1663B4;
  /* 那不勒斯黄 ramp */
  --yel100: #FFF6D9; --yel200: #FFE9A8; --yel400: #FFD23F; --yel500: #FFC414; --yel600: #E0A800;
  /* 墨色 */
  --ink: #182A3D; --ink2: #51637A; --ink3: #7A8FA5; --line: #E6EEF6;
  /* 功能色 */
  --green: #2FA96E; --red: #F0655A; --wechat: #07C160;
  --coral: #FF8A5C; --violet: #7B8CFF; --teal: #2BB8A8;
  /* 面 */
  --bg: #F3F8FC; --card: #FFFFFF;
  /* 影 */
  --sh-card: 0 2rpx 8rpx rgba(23, 84, 153, 0.04), 0 12rpx 36rpx rgba(23, 84, 153, 0.08);
  /* 导航返回钮底（令牌化：组件不跟系统媒体查询，跟页面主题走——1.5.22） */
  --nb-back-bg: rgba(255,255,255,.9);
  --sh-float: 0 20rpx 56rpx rgba(23, 84, 153, 0.18);
  --sh-yellow: 0 12rpx 32rpx rgba(255, 196, 20, 0.35);

  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.45;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif;
}

view, text, image, input, button, textarea { box-sizing: border-box; }
button::after { border: none; }

/* ---------- 页面画布 ---------- */
.screen { position: relative; width: 100vw; height: 100vh; overflow: hidden; background: var(--bg); color: var(--ink); display: flex; flex-direction: column; }
.scroll { flex: 1; overflow: hidden; position: relative; }

/* ---------- 字级 ---------- */
.t-hero { font-size: 46rpx; font-weight: 800; letter-spacing: 1rpx; }
.t-title { font-size: 36rpx; font-weight: 700; }
.t-sec { font-size: 32rpx; font-weight: 700; }
.t-body { font-size: 28rpx; }
.t-sub { font-size: 25rpx; color: var(--ink2); }
.t-cap { font-size: 22rpx; color: var(--ink3); }
.num { font-weight: 800; font-variant-numeric: tabular-nums; }

/* ---------- 按钮 ---------- */
.btn {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  height: 96rpx; border-radius: 48rpx; font-size: 32rpx; font-weight: 700;
  background: linear-gradient(135deg, var(--sky400), var(--sky600)); color: #fff;
  box-shadow: 0 16rpx 40rpx rgba(46, 146, 237, 0.32);
}
.btn.yellow {
  background: linear-gradient(135deg, #FFDE5C, var(--yel500)); color: #6B5200;
  box-shadow: var(--sh-yellow);
}
.btn.ghost { background: var(--card); color: var(--sky600); border: 3rpx solid var(--sky200); box-shadow: none; }
.btn.small { height: 68rpx; border-radius: 34rpx; font-size: 26rpx; padding: 0 32rpx; box-shadow: none; }
.btn.mini { height: 56rpx; border-radius: 28rpx; font-size: 24rpx; padding: 0 24rpx; box-shadow: none; font-weight: 600; }
.btn .ic { width: 34rpx; height: 34rpx; }
.btn-block { width: 100%; }

/* ---------- 卡片 ---------- */
.card { background: var(--card); border-radius: 40rpx; box-shadow: var(--sh-card); }

/* ---------- 行程卡 ---------- */
.trip-card { overflow: hidden; }
.trip-cover { position: relative; height: 300rpx; overflow: hidden; }
.trip-cover .cover-img { width: 100%; height: 100%; }
.trip-cover .cover-scrim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: linear-gradient(180deg, rgba(12,40,70,0) 30%, rgba(12,40,70,.55)); }
.trip-cover .trip-chip {
  position: absolute; top: 24rpx; left: 24rpx; display: flex; align-items: center; gap: 10rpx;
  background: rgba(255,255,255,.92); border-radius: 999rpx; padding: 8rpx 20rpx;
  font-size: 22rpx; font-weight: 700; color: var(--sky700);
}
.trip-cover .trip-chip i { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--green); }
.trip-cover .date-chip {
  position: absolute; bottom: 24rpx; right: 24rpx; background: var(--yel400); color: #6B5200;
  font-size: 22rpx; font-weight: 800; border-radius: 999rpx; padding: 8rpx 20rpx; box-shadow: var(--sh-yellow);
}
.trip-body { padding: 26rpx 32rpx 28rpx; }
.trip-body .tt { font-size: 34rpx; font-weight: 800; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.trip-meta { display: flex; align-items: center; gap: 16rpx; margin-top: 8rpx; font-size: 24rpx; color: var(--ink2); }

/* ---------- 头像 ---------- */
.avatar {
  width: 68rpx; height: 68rpx; border-radius: 50%; flex: none;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 26rpx; font-weight: 700; border: 4rpx solid #fff;
}
.av-blue { background: linear-gradient(135deg, var(--sky400), var(--sky600)); }
.av-yellow { background: linear-gradient(135deg, #FFDE5C, var(--yel500)); color: #6B5200; }
.av-green { background: linear-gradient(135deg, #4BC48B, var(--green)); }
.av-coral { background: linear-gradient(135deg, #FFA275, var(--coral)); }
.av-violet { background: linear-gradient(135deg, #9AA8FF, var(--violet)); }
.av-gray { background: #C3D2E0; }
.avatar.sm { width: 52rpx; height: 52rpx; font-size: 22rpx; }
.avatar.lg { width: 104rpx; height: 104rpx; font-size: 38rpx; }
.av-stack { display: flex; }
.av-stack .avatar { margin-left: -18rpx; }
.av-stack .avatar:first-child { margin-left: 0; }
.av-stack .more { background: var(--sky100); color: var(--sky600); font-size: 22rpx; font-weight: 700; }

/* ---------- 标签 / 徽标 ---------- */
.tag { display: inline-flex; align-items: center; gap: 6rpx; border-radius: 12rpx; padding: 4rpx 14rpx; font-size: 21rpx; font-weight: 600; }
.tag.blue { background: var(--sky100); color: var(--sky600); }
.tag.yellow { background: var(--yel100); color: #A97E00; }
.tag.green { background: #E4F6EC; color: var(--green); }
.tag.red { background: #FDEAE8; color: var(--red); }
.tag.gray { background: #EFF4F9; color: var(--ink2); }

/* ---------- 筛选 chips ---------- */
.chips { display: flex; gap: 16rpx; overflow: hidden; }
.chip {
  flex: none; height: 64rpx; padding: 0 30rpx; border-radius: 32rpx; background: var(--card);
  color: var(--ink2); font-size: 26rpx; font-weight: 500; display: flex; align-items: center;
  border: 2rpx solid var(--line);
}
.chip.on { background: var(--sky500); color: #fff; border-color: var(--sky500); font-weight: 700; box-shadow: 0 8rpx 24rpx rgba(46,146,237,.28); }
.chip.yellow-on { background: var(--yel400); color: #6B5200; border-color: var(--yel400); font-weight: 700; }

/* ---------- 区块标题 ---------- */
.sec { display: flex; align-items: center; justify-content: space-between; padding: 0 32rpx; margin: 36rpx 0 20rpx; }
.sec .h { font-size: 33rpx; font-weight: 800; display: flex; align-items: center; gap: 12rpx; }
.sec .more { font-size: 24rpx; color: var(--ink3); display: flex; align-items: center; gap: 4rpx; }
.sec .more .ic { width: 24rpx; height: 24rpx; }

/* ---------- 列表 cell ---------- */
.cell { display: flex; align-items: center; gap: 24rpx; background: var(--card); border-radius: 28rpx; padding: 26rpx 28rpx; }
.cell .cell-ic { width: 76rpx; height: 76rpx; border-radius: 24rpx; flex: none; display: flex; align-items: center; justify-content: center; }
.cell .cell-ic .ic { width: 38rpx; height: 38rpx; }
.cell .cell-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.cell .cell-main .h { font-size: 29rpx; font-weight: 600; }
/* 历史笔误根修（1.5.30）：原写 p 元素选择器从未命中 text class="p"——此前依赖 settings 页面级补丁 */
.cell .cell-main .p { font-size: 23rpx; color: var(--ink3); margin-top: 2rpx; }
.cell .cell-right { display: flex; align-items: center; gap: 8rpx; color: var(--ink3); font-size: 24rpx; }
.cell .cell-right .ic { width: 28rpx; height: 28rpx; }

/* ---------- 图标（CSS mask，WebView 渲染；Skyline 需换 image/iconfont） ---------- */
