.ic-drag { -webkit-mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='black'><circle cx='9' cy='6' r='1.6'/><circle cx='15' cy='6' r='1.6'/><circle cx='9' cy='12' r='1.6'/><circle cx='15' cy='12' r='1.6'/><circle cx='9' cy='18' r='1.6'/><circle cx='15' cy='18' r='1.6'/></svg>"); mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='black'><circle cx='9' cy='6' r='1.6'/><circle cx='15' cy='6' r='1.6'/><circle cx='9' cy='12' r='1.6'/><circle cx='15' cy='12' r='1.6'/><circle cx='9' cy='18' r='1.6'/><circle cx='15' cy='18' r='1.6'/></svg>"); }
.ic-more-circle { -webkit-mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.8'><circle cx='12' cy='12' r='8.5' stroke-dasharray='3.5 2.2'/></svg>"); mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.8'><circle cx='12' cy='12' r='8.5' stroke-dasharray='3.5 2.2'/></svg>"); }

/* ---------- 输入框 ---------- */
.input:focus-within { border-color: var(--sky300); box-shadow: 0 0 0 3rpx rgba(46,146,237,0.08); }
.input {
  display: flex; align-items: center; gap: 16rpx; background: var(--card); border-radius: 40rpx;
  height: 80rpx; padding: 0 28rpx; border: 2rpx solid var(--line);
}
.input .ic { width: 32rpx; height: 32rpx; color: var(--ink3); }
.input .ph { color: var(--ink3); font-size: 27rpx; }

/* ---------- 分段控件 ---------- */
.seg { display: flex; background: var(--sky100); border-radius: 34rpx; padding: 6rpx; }
.seg .it { flex: 1; text-align: center; font-size: 25rpx; font-weight: 600; color: var(--ink2); padding: 10rpx 0; border-radius: 28rpx; }
.seg .it.on { background: var(--card); color: var(--sky600); box-shadow: 0 4rpx 12rpx rgba(23,84,153,.14); font-weight: 800; }

/* ---------- 进度条 ---------- */
.progress { height: 14rpx; border-radius: 8rpx; background: var(--sky100); overflow: hidden; }
.progress .bar { display: block; height: 100%; border-radius: 8rpx; background: linear-gradient(90deg, var(--yel400), var(--yel500)); }

/* ---------- 底部弹层 ---------- */
.sheet-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(15,35,60,.45); z-index: 390; animation: maskIn 0.28s ease both; }
/* z-index 400>tabBar 300：tab 页（profile 等）弹层按钮区曾被 tabBar 遮挡致无法点确定（1.5.22 修复） */
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 400; background: var(--card);
  border-radius: 48rpx 48rpx 0 0; padding: 20rpx 36rpx 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  animation: sheetUp 0.34s cubic-bezier(0.16, 1, 0.3, 1);
}
.sheet .grab { width: 76rpx; height: 9rpx; border-radius: 6rpx; background: #DCE6EF; margin: 0 auto 24rpx; }

/* ---------- 聊天 ---------- */
.msg { display: flex; gap: 16rpx; margin-bottom: 28rpx; }
.msg .avatar { width: 64rpx; height: 64rpx; font-size: 24rpx; }
.bubble { max-width: 500rpx; border-radius: 8rpx 32rpx 32rpx 32rpx; background: var(--card); box-shadow: var(--sh-card); padding: 22rpx 26rpx; font-size: 27rpx; line-height: 1.55; }
.msg.me { flex-direction: row-reverse; }
.msg.me .bubble { background: linear-gradient(135deg, var(--sky400), var(--sky600)); color: #fff; border-radius: 32rpx 8rpx 32rpx 32rpx; box-shadow: 0 12rpx 32rpx rgba(46,146,237,.28); }

/* ---------- FAB ---------- */
.fab:active { transform: scale(0.94); transition: transform 0.12s ease; }
.fab { transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1); }
.fab {
  position: fixed; right: 32rpx; z-index: 35;
  display: flex; align-items: center; gap: 12rpx; height: 88rpx; padding: 0 32rpx 0 24rpx; border-radius: 44rpx;
  background: linear-gradient(135deg, #FFDE5C, var(--yel500)); color: #6B5200; font-weight: 800; font-size: 28rpx;
  box-shadow: var(--sh-yellow);
}
.fab .ic { width: 36rpx; height: 36rpx; }

/* ---------- 二维码装饰 ---------- */
.qr-fake {
  background:
    conic-gradient(from 0deg at 75% 75%, #182A3D 25%, transparent 0) 0 0/28rpx 28rpx,
    conic-gradient(from 90deg at 25% 25%, #182A3D 25%, transparent 0) 14rpx 14rpx/28rpx 28rpx,
    #fff;
}
.qr-box { position: relative; background: #fff; border-radius: 24rpx; padding: 16rpx; overflow: hidden; }
.qr-box .qr-inner { width: 100%; height: 100%; border-radius: 16rpx; position: relative; }
.qr-box .qr-inner::after {
  content: ""; position: absolute; left: 50%; top: 50%; width: 52rpx; height: 52rpx; transform: translate(-50%,-50%);
  background: var(--yel400); border-radius: 12rpx; border: 6rpx solid #fff;
}

/* ============================================================
   动效系统（原则：动画要有动机——层级/叙事/反馈/状态变化；
   只动 transform 与 opacity；曲线统一 spring 感）
   ============================================================ */
@keyframes riseIn {
  from { opacity: 0; transform: translate3d(0, 28rpx, 0); }
  to   { opacity: 1; transform: translate3d(0, 0, 0); }
}
@keyframes popIn {
  from { opacity: 0; transform: scale(0.96) translate3d(0, 12rpx, 0); }
  to   { opacity: 1; transform: none; }
}
@keyframes sheetUp {
  from { transform: translate3d(0, 100%, 0); }
  to   { transform: translate3d(0, 0, 0); }
}
@keyframes maskIn {
  from { opacity: 0; } to { opacity: 1; }
}
@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50%      { transform: scale(1.4); opacity: 0.5; }
}
@keyframes floatY {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-14rpx); }
}
@keyframes shimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}

/* 入场：卡片级 rise + 级联延迟 */
.anim-rise { animation: riseIn 0.55s cubic-bezier(0.16, 1, 0.3, 1) both; }
.anim-pop  { animation: popIn 0.42s cubic-bezier(0.16, 1, 0.3, 1) both; }
.d1 { animation-delay: 0.07s; }
.d2 { animation-delay: 0.14s; }
.d3 { animation-delay: 0.21s; }
.d4 { animation-delay: 0.28s; }

/* 按压反馈：配合 hover-class 使用（view 组件） */
.press { opacity: 0.82; transform: scale(0.985); }
.trip-row, .btn, .chip, .act, .pk-item, .lk-item, .city-chip, .day-pill {
  transition: opacity 0.15s ease, transform 0.15s ease;
}
.trip-row:active, .btn:active, .act:active {
  opacity: 0.85; transform: scale(0.98);
}
.tab-item image { transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1); }
.btn, .chip, .cell, .act, .trip-row, .trans, .day-card, .create-btn,
.add-btn, .added-btn, .key, .payer, .cat-c, .way, .tab-press {
  transition: opacity 0.15s ease, transform 0.15s ease;
}

/* 骨架屏占位（配合加载态使用） */
.skeleton {
  background: linear-gradient(90deg, #EFF4F9 25%, #F7FAFD 37%, #EFF4F9 63%);
  background-size: 800rpx 100%;
  animation: shimmer 1.4s linear infinite;
}

/* 减弱动态效果：跟随系统无障碍设置 */
@media (prefers-reduced-motion: reduce) {
  .anim-rise, .anim-pop, .sheet, .sheet-mask, .skeleton { animation: none; }
  .btn, .chip, .cell, .act, .trip-row, .trans, .day-card, .create-btn,
  .add-btn, .added-btn, .key, .payer, .cat-c, .way, .tab-press { transition: none; }
}


/* ============================================================
   夜间模式令牌：跟随系统=媒体查询；手动覆盖=根节点 .theme-dark/.theme-light
   ============================================================ */
@media (prefers-color-scheme: dark) {
page {
  --bg: #0D1724; --card: #152334; --ink: #E8F0F9; --ink2: #9FB3C8; --ink3: #64798F; --line: #23364B;
  --nb-back-bg: rgba(36,56,80,.92);
  --sky50: #12233A; --sky100: #17304B; --sky200: #1E3F63;
  --yel100: #3B3320; --yel200: #4A3F26;
  --sh-card: 0 2rpx 8rpx rgba(0,0,0,.18), 0 12rpx 36rpx rgba(0,0,0,.26);
}
}

.theme-light {
  --bg: #F3F8FC; --card: #FFFFFF; --ink: #182A3D; --ink2: #51637A; --ink3: #7A8FA5; --line: #E6EEF6;
  --nb-back-bg: rgba(255,255,255,.9);
  --sky50: #F1F8FE; --sky100: #E3F0FD; --sky200: #C6E2FB;
  --yel100: #FFF6D9; --yel200: #FFE9A8;
  --sh-card: 0 2rpx 8rpx rgba(23,84,153,.04), 0 12rpx 36rpx rgba(23,84,153,.08);
}

.theme-dark {
  --bg: #0D1724; --card: #152334; --ink: #E8F0F9; --ink2: #9FB3C8; --ink3: #64798F; --line: #23364B;
  --nb-back-bg: rgba(36,56,80,.92);
  --sky50: #12233A; --sky100: #17304B; --sky200: #1E3F63;
  --yel100: #3B3320; --yel200: #4A3F26;
  --sh-card: 0 2rpx 8rpx rgba(0,0,0,.18), 0 12rpx 36rpx rgba(0,0,0,.26);
}

/* 浅色硬编码页面背景在暗色下收敛 */
@media (prefers-color-scheme: dark) {
  .home, .messages, .create, .aiscreen { background: var(--bg); }
  .welcome { background: linear-gradient(180deg, #10202F 0%, #132433 34%, #0D1724 70%); }
  .home { background: linear-gradient(180deg, #132433 0%, #0D1724 600rpx); }
  .profile .bg-tint { background: linear-gradient(180deg, #132433 0%, var(--bg) 100%); }
  .mapscreen { background: #0C141D; }
}
.home.theme-dark, .messages.theme-dark, .create.theme-dark, .aiscreen.theme-dark { background: var(--bg); }
.welcome.theme-dark { background: linear-gradient(180deg, #10202F 0%, #132433 34%, #0D1724 70%); }
.home.theme-dark { background: linear-gradient(180deg, #132433 0%, #0D1724 600rpx); }
.profile.theme-dark .bg-tint { background: linear-gradient(180deg, #132433 0%, var(--bg) 100%); }
.mapscreen.theme-dark { background: #0C141D; }

/* 深色补丁：固定亮底改半透明深色调，避免深色下刺眼或文字失效 */
@media (prefers-color-scheme: dark) {
  .tag.green { background: rgba(47,169,110,.16); }
  .tag.red { background: rgba(240,101,90,.16); }
  .tag.gray { background: rgba(159,179,200,.16); }
  .tag.yellow { background: rgba(255,196,20,.16); color: #F2D488; }
  .sheet .grab { background: var(--line); }
  .skeleton { background: linear-gradient(90deg, #17293D 25%, #1E334B 37%, #17293D 63%); background-size: 800rpx 100%; }
}
