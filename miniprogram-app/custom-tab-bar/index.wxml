<view class="tb">
  <block wx:for="{{list}}" wx:key="index">
    <!-- 中央出发模式：黄底 + 狗狗logo + 文字 -->
    <view wx:if="{{item.type === 'cta'}}" class="tb-ai tab-press" hover-class="press" hover-stay-time="80" data-path="{{item.path}}" bindtap="switchTab">
      <image class="tb-ai-face" src="/assets/logo.png" mode="aspectFill" />
      <text class="tb-ai-txt">{{item.text}}</text>
    </view>
    <!-- 普通页签 -->
    <view wx:else class="tb-tab tab-press {{selected === index ? 'on' : ''}}" hover-class="press" hover-stay-time="80" data-path="{{item.path}}" bindtap="switchTab">
      <view class="ic ic-{{item.icon}}"></view>
      <text>{{item.text}}</text>
    </view>
  </block>
</view>
