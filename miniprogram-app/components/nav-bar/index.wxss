.nb { position: relative; z-index: 100; }
.nb-photo { position: absolute; left: 0; top: 0; right: 0; z-index: 110; }
.nb-bar { position: relative; display: flex; align-items: center; padding: 0 208rpx 0 28rpx; }

.nb-title {
  position: absolute; left: 0; right: 174rpx; text-align: center;
  font-size: 33rpx; font-weight: 700; color: var(--ink); pointer-events: none;
}
.nb-title.on-photo { color: #fff; }
/* float 模式的极淡标题（可选），不挡内容 */
.nb-float-title {
  position: absolute; left: 120rpx; right: 208rpx; text-align: left; padding-left: 0;
  font-size: 27rpx; font-weight: 600; color: var(--ink2); opacity: .9;
}
.nb-float-title.on-photo { color: #fff; }
.nb-slot { flex: 1; min-width: 0; display: flex; align-items: center; }

.nb-back {
  width: 60rpx; height: 60rpx; border-radius: 50%; flex: none;
  /* 令牌化：跟页面主题（手动浅色档+系统深色的混搭曾致深钮压浅底，1.5.22） */
  background: var(--nb-back-bg, rgba(255,255,255,.9)); box-shadow: 0 4rpx 16rpx rgba(23,84,153,.10);
  display: flex; align-items: center; justify-content: center;
}
.nb-back .ic { width: 32rpx; height: 32rpx; color: var(--ink); }
.nb-back.on-photo { background: rgba(24,42,61,.30); }
.nb-back.on-photo .ic { color: #fff; }

/* 深色阴影随 --nb-back-bg 令牌走（1.5.22 令牌化后媒体查询只补投影） */
@media (prefers-color-scheme: dark) {
  .nb-back { box-shadow: 0 4rpx 16rpx rgba(0,0,0,.3); }
}
