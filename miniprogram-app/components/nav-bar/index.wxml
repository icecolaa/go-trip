<!-- 自定义导航：状态栏 + 导航行
     float 模式：去掉标题表头，只留悬浮返回键（布局占位不变，内容零位移）
     右上角不放胶囊——微信原生胶囊常驻同位，自绘只会叠影（1.5.20 移除） -->
<view class="nb {{photo ? 'nb-photo' : ''}}" style="padding-top:{{sbH}}px">
  <view class="nb-bar" style="height:{{navH}}px">
    <view wx:if="{{back}}" class="nb-back {{photo ? 'on-photo' : ''}}" hover-class="press" hover-stay-time="80" bindtap="goBack">
      <view class="ic ic-back"></view>
    </view>
    <view wx:if="{{!float && title}}" class="nb-title {{photo ? 'on-photo' : ''}}">{{title}}</view>
    <view wx:elif="{{!float}}" class="nb-slot">
      <slot></slot>
    </view>
    <view wx:if="{{float && title}}" class="nb-float-title {{photo ? 'on-photo' : ''}}">{{title}}</view>
  </view>
</view>
