  "cards": [
    {
      "dot": "emerald",
      "title": "协作能力（行程域）",
      "items": [
        "行程 / 预算 / 清单 / 锦囊 / 日志，成员按 owner / admin / editor / viewer 协作",
        "邀请码加入与只读分享链接（share_token）",
        "AI 攻略解析：整册覆盖或精准重写某几天"
      ]
    },
    {
      "dot": "amber",
      "title": "数据与迁移",
      "items": [
        "双方言 DDL：PG 顺序 await，SQLite try/catch 兜底；启动自动建表 + 种子",
        "flywhere_watch 价格记忆：按路线记录最低单人价，重查返回涨跌"
      ]
    },
    {
      "dot": "orange",
      "title": "飞哪儿链路",
      "items": [
        "spawn 飞猪子进程：串行队列 + 429 退避",
        "双层缓存：原始 10 分钟 / 搜索 30 分钟，键含全部参数"
      ]
    },
    {
      "dot": "rose",
      "title": "安全与信任",
      "items": [
        "Bearer 会话 + 角色鉴权；上传 dataURL 校验与防穿越，body 上限 25MB",
        "密钥只存环境变量，绝不进仓库与部署包"
      ]
    },
    {
      "dot": "cyan",
      "title": "部署与保活",
      "items": [
        "PocketBay Docker + Cloudflare 边缘，闲置休眠靠 keepalive 心跳",
        "client/dist 与 /guide 静态页由同一 Node 进程托管"
      ]
    }
  ],
