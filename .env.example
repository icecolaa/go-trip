# ===== GoTrip 服务器配置 =====
# 【可选】PocketBay 等平台托管的 PostgreSQL 连接串；设置后使用 PG，否则使用本地 SQLite
# 平台部署成功时会自动注入 DATABASE_URL（走 TLS，禁止 sslmode=disable）
DATABASE_URL=
# 服务端口
GOTRIP_PORT=8787
# 数据库文件路径（仅 SQLite 回退模式生效）
GOTRIP_DB=./data/gotrip.db
# 跨域来源，开发模式下 vite 已代理，一般无需修改
GOTRIP_ORIGIN=*

# ===== 高德开放平台（可选）=====
# 配置后启用真实 POI 搜索（Web 服务 API）；不配置则使用内置城市景点数据
GOTRIP_AMAP_KEY=
# 高德 JS API Key（前端地图若需使用官方 JSAPI 时使用；默认使用瓦片地图无需 Key）

# ===== AI 大模型（可选）=====
# 任意 OpenAI 兼容接口均可：智谱 GLM / DeepSeek / 通义千问 / Moonshot / OpenAI
# 示例（智谱）：https://open.bigmodel.cn/api/paas/v4  model: glm-4-flash
# 示例（DeepSeek）：https://api.deepseek.com/v1   model: deepseek-chat
GOTRIP_AI_BASE_URL=
GOTRIP_AI_API_KEY=
GOTRIP_AI_MODEL=

# ===== 飞哪里 FlyWhere（机票低价探索）=====
# 飞猪 AI 开放平台 Key；未配置时飞哪里页不可用
FLYAI_API_KEY=
