{
  "name": "@gotrip/miniprogram",
  "version": "0.1.0",
  "private": true,
  "description": "出发吧 GoTrip 微信小程序客户端（Taro 3 + React 18），复用 server API 与 shared 类型",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "none",
    "framework": "React"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "check": "tsc --noEmit",
    "preview": "node scripts/upload.js preview",
    "upload": "node scripts/upload.js"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@cloudbase/wx-cloud-client-sdk": "^1.8.10",
    "@tarojs/components": "3.6.25",
    "@tarojs/helper": "3.6.25",
    "@tarojs/plugin-framework-react": "3.6.25",
    "@tarojs/plugin-platform-h5": "3.6.25",
    "@tarojs/plugin-platform-weapp": "3.6.25",
    "@tarojs/react": "3.6.25",
    "@tarojs/runtime": "3.6.25",
    "@tarojs/shared": "3.6.25",
    "@tarojs/taro": "3.6.25",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@tarojs/cli": "3.6.25",
    "@tarojs/plugin-platform-h5": "^3.6.25",
    "@tarojs/webpack5-runner": "3.6.25",
    "@types/react": "^18.2.79",
    "@types/webpack-env": "^1.18.4",
    "babel-preset-taro": "3.6.25",
    "miniprogram-ci": "^2.1.14",
    "typescript": "^5.4.5",
    "webpack": "5.91.0"
  }
}
