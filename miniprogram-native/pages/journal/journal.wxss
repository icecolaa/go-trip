.journal .scroll { padding-bottom: 40rpx; }
.j-entry { background: var(--card); border-radius: 32rpx; box-shadow: var(--sh-card); padding: 24rpx 26rpx; margin: 12rpx 32rpx 20rpx; }
.j-head { display: flex; align-items: center; gap: 16rpx; }
.j-day {
  width: 84rpx; height: 84rpx; border-radius: 24rpx; background: linear-gradient(135deg, var(--sky400), var(--sky600));
  color: #fff; font-size: 25rpx; font-weight: 900; display: flex; align-items: center; justify-content: center; flex: none;
}
.j-meta { flex: 1; display: flex; flex-direction: column; }
.j-date { font-size: 25rpx; font-weight: 800; color: var(--ink); }
.j-mood { font-size: 21rpx; color: var(--ink3); margin-top: 2rpx; }
.j-ops { display: flex; gap: 8rpx; }
.j-op { width: 52rpx; height: 52rpx; border-radius: 50%; background: var(--bg); display: flex; align-items: center; justify-content: center; }
.j-op .ic { width: 24rpx; height: 24rpx; color: var(--ink3); }
.j-text { display: block; font-size: 26rpx; color: var(--ink); line-height: 1.6; margin-top: 16rpx; }
.j-imgs { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.j-img { width: 200rpx; height: 200rpx; border-radius: 16rpx; }

.j-empty { display: flex; flex-direction: column; align-items: center; gap: 10rpx; padding: 100rpx 0 40rpx; }
.j-empty-t { font-size: 30rpx; font-weight: 800; color: var(--ink2); }
.j-empty-s { font-size: 23rpx; color: var(--ink3); }

.j-add { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 28rpx; margin: 0 32rpx; }
.j-add-ic { width: 76rpx; height: 76rpx; border-radius: 24rpx; background: var(--yel100); display: flex; align-items: center; justify-content: center; flex: none; }
.j-add-ic .ic { width: 36rpx; height: 36rpx; color: #FFC414; }
.j-add-txt { flex: 1; display: flex; flex-direction: column; }
.j-add-txt .t { font-size: 28rpx; font-weight: 800; color: var(--ink); }
.j-add-txt .s { font-size: 21rpx; color: var(--ink3); margin-top: 2rpx; }

.j-sheet { height: 1000rpx; display: flex; flex-direction: column; }
.j-head-bar { display: flex; align-items: center; padding-bottom: 16rpx; }
.j-head-bar .t { font-size: 34rpx; font-weight: 900; color: var(--ink); }
.j-head-bar .x { margin-left: auto; width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--bg); display: flex; align-items: center; justify-content: center; }
.j-head-bar .x .ic { width: 26rpx; height: 26rpx; color: var(--ink3); }
.j-days { display: flex; gap: 12rpx; flex-wrap: wrap; padding-bottom: 16rpx; }
.j-day-chip { height: 56rpx; padding: 0 22rpx; border-radius: 28rpx; background: var(--bg); color: var(--ink2); font-size: 23rpx; line-height: 52rpx; font-weight: 600; }
.j-day-chip.on { background: var(--sky500); color: #fff; font-weight: 800; }
.j-input {
  width: 100%; height: 220rpx; background: var(--bg); border-radius: 24rpx; padding: 20rpx 24rpx;
  font-size: 26rpx; color: var(--ink); box-sizing: border-box;
}
.ph { color: var(--ink3); }
.j-pick { display: flex; align-items: center; gap: 12rpx; padding: 20rpx 4rpx; font-size: 24rpx; color: var(--ink2); }
.j-pick .ic { width: 30rpx; height: 30rpx; }
.j-save { margin-top: auto; margin-bottom: 20rpx; }
