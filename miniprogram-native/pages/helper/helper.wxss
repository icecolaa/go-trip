.helper { display: flex; flex-direction: column; background: var(--bg); }
.h-scroll { flex: 1; overflow: hidden; padding: 12rpx 32rpx 0; box-sizing: border-box; }
.h-hero { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 28rpx; margin-bottom: 20rpx; }
.h-hero .face { width: 88rpx; height: 88rpx; border-radius: 50%; border: 4rpx solid #fff; box-shadow: 0 8rpx 24rpx rgba(255,196,20,.4); }
.h-hero .t { display: flex; flex-direction: column; }
.h-hero .n { font-size: 30rpx; font-weight: 900; color: var(--ink); }
.h-hero .s { font-size: 21rpx; color: var(--ink3); margin-top: 4rpx; }

.h-qa { background: var(--card); border-radius: 28rpx; box-shadow: var(--sh-card); margin-bottom: 16rpx; overflow: hidden; }
.h-q { display: flex; align-items: center; padding: 24rpx 26rpx; }
.h-q text { flex: 1; font-size: 27rpx; font-weight: 700; color: var(--ink); }
.h-a { padding: 0 26rpx 24rpx; }
.h-a text { font-size: 25rpx; color: var(--ink2); line-height: 1.65; }

.h-inputbar {
  flex: none; display: flex; align-items: center; gap: 18rpx;
  padding: 18rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--card); border-top: 2rpx solid var(--line);
}
.h-field { flex: 1; height: 76rpx; border-radius: 38rpx; background: var(--bg); padding: 0 28rpx; font-size: 26rpx; color: var(--ink); }
.ph { color: var(--ink3); }
.h-send { width: 76rpx; height: 76rpx; border-radius: 50%; background: linear-gradient(135deg, var(--sky400), var(--sky600)); display: flex; align-items: center; justify-content: center; flex: none; }
.h-send .ic { width: 34rpx; height: 34rpx; }
