.schedule .scroll { padding-bottom: 220rpx; }

.days-bar { display: flex; gap: 14rpx; padding: 12rpx 32rpx 8rpx; }
.day-pill {
  flex: 1; height: 104rpx; border-radius: 28rpx; background: var(--card); border: 2rpx solid var(--line);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx;
}
.day-pill .b { font-size: 27rpx; font-weight: 800; color: #51637A; }
.day-pill .s { font-size: 19rpx; color: #93A5B8; }
.day-pill.on { background: linear-gradient(135deg, #FFDE5C, var(--yel500)); border-color: transparent; box-shadow: var(--sh-yellow); }
.day-pill.on .b { color: #6B5200; }
.day-pill.on .s { color: #8A6D1A; }

.date-line { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 32rpx 12rpx; }
.date-line .d { font-size: 30rpx; font-weight: 800; color: #182A3D; }
.date-line .w { font-size: 23rpx; color: #93A5B8; }

.tl { padding: 4rpx 32rpx 0; }
.tl-item { display: flex; gap: 20rpx; position: relative; padding-bottom: 20rpx; }
.tl-item.last { padding-bottom: 0; }
.tl-time { width: 88rpx; flex: none; text-align: center; padding-top: 28rpx; }
.tl-time text { font-size: 25rpx; color: #182A3D; font-weight: 700; }
.tl-node { width: 36rpx; flex: none; display: flex; flex-direction: column; align-items: center; }
.tl-node .dot { width: 24rpx; height: 24rpx; border-radius: 50%; background: #fff; border: 6rpx solid var(--sky400); margin-top: 34rpx; flex: none; position: relative; z-index: 2; }
.tl-node .dot.meal { border-color: var(--yel400); }
.tl-node .dot.blue-meal { border-color: var(--sky400); }
.tl-node .bar { flex: 1; width: 4rpx; background: var(--sky200); margin-top: 4rpx; }

.tl-card {
  flex: 1; background: var(--card); border-radius: 28rpx; box-shadow: var(--sh-card);
  padding: 24rpx; display: flex; gap: 20rpx; min-width: 0;
}
.tl-card.pad-sm { padding: 22rpx 24rpx; align-items: center; }
.tl-thumb { width: 124rpx; height: 124rpx; border-radius: 20rpx; flex: none; }
.tl-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.tl-main .h { font-size: 29rpx; font-weight: 800; color: #182A3D; }
.tl-card.pad-sm .tl-main .h { font-weight: 800; }
.t-title { display: flex; align-items: center; gap: 12rpx; }
.t-title .h { flex: 1; }
.t-title .ic { width: 24rpx; height: 24rpx; }
.t-title .rate { font-size: 24rpx; color: #E0A800; font-weight: 800; }
.tl-main .s { display: flex; align-items: center; gap: 8rpx; font-size: 23rpx; color: #51637A; margin-top: 6rpx; flex-wrap: wrap; }
.tl-main .s .ic { width: 24rpx; height: 24rpx; }
.tags { display: flex; align-items: center; gap: 10rpx; margin-top: 12rpx; flex-wrap: wrap; }
.meta-txt { font-size: 23rpx; color: #51637A; }
.t-foot { display: flex; align-items: center; gap: 12rpx; margin-top: 14rpx; }
.who { display: flex; align-items: center; gap: 8rpx; font-size: 21rpx; color: #93A5B8; }
.who .avatar { width: 32rpx; height: 32rpx; font-size: 17rpx; border-width: 2rpx; }
.mini-tile { width: 88rpx; height: 88rpx; border-radius: 24rpx; flex: none; display: flex; align-items: center; justify-content: center; }
.mini-tile .ic { width: 40rpx; height: 40rpx; }
.mini-tile.yellow { background: var(--yel100); }
.mini-tile.yellow .ic { color: var(--yel500); }
.mini-tile.blue { background: var(--sky100); }
.mini-tile.blue .ic { color: var(--sky500); }
.drag { width: 28rpx; height: 28rpx; color: #C9D6E3; align-self: center; }

.drive-chip { display: flex; align-items: center; gap: 12rpx; margin: 0 32rpx 20rpx 124rpx; font-size: 22rpx; color: #51637A; }
.drive-chip .d-ic { width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--sky100); display: flex; align-items: center; justify-content: center; }
.drive-chip .d-ic .ic { width: 24rpx; height: 24rpx; color: var(--sky600); }

.cta-space { height: 40rpx; }
.bottom-cta {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 35;
  padding: 20rpx 32rpx calc(44rpx + env(safe-area-inset-bottom));
  display: flex; gap: 20rpx;
  background: linear-gradient(180deg, rgba(243,248,252,0), var(--bg) 40%);
}
.map-btn {
  width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--card);
  border: 3rpx solid var(--sky200); display: flex; align-items: center; justify-content: center; flex: none;
}
.map-btn .ic { width: 40rpx; height: 40rpx; color: var(--sky600); }
.grow { flex: 1; }

/* 数据驱动新增样式 */
.tl-main .s { display: flex; align-items: center; gap: 10rpx; margin-top: 8rpx; flex-wrap: wrap; }
.tl-main .note { font-size: 22rpx; color: #93A5B8; }
.mini-tile.green { background: #E4F6EC; }
.mini-tile.green .ic { color: #2FA96E; }
.mini-tile .ic { width: 40rpx; height: 40rpx; color: #51637A; }
.tl-card .op { width: 56rpx; height: 56rpx; border-radius: 16rpx; background: var(--bg); display: flex; align-items: center; justify-content: center; align-self: center; flex: none; }
.tl-card .op .ic { width: 30rpx; height: 30rpx; color: #C9D6E3; }
.tl-node .dot.stay { border-color: #2BB8A8; }
.empty { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 80rpx 0; color: #93A5B8; font-size: 26rpx; }
.grow { flex: 1; }
